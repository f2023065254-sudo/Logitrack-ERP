@model Logitrack_ERP.Models.ReportApiResponse<Logitrack_ERP.Models.RevenueSummaryItem>
@{
    ViewData["Title"] = "Revenue Summary";
}

<div class="warehouse-management-wrapper" style="padding: 24px; background-color: #f8fafc; min-height: 100vh;">

    @* 1. THIS BLOCK WILL CATCH AND DISPLAY ERRORS *@
    @if (ViewBag.ErrorMessage != null)
    {
        <div style="background-color: #fee2e2; color: #991b1b; padding: 16px; border-radius: 8px; margin-bottom: 20px; border: 1px solid #f87171;">
            <h3 style="margin-top:0;">API Connection Failed</h3>
            <p>@ViewBag.ErrorMessage</p>
        </div>
    }
    @* 2. THIS BLOCK DISPLAYS THE DATA IF SUCCESSFUL *@
    else if (Model != null && Model.Data != null)
    {
        <div class="module-header" style="margin-bottom: 24px;">
            <span style="background-color: #ecfdf5; color: #10b981; padding: 6px 12px; border-radius: 20px; font-size: 0.8rem; font-weight: 700; margin-bottom: 12px; display: inline-block;">LIVE API DATA</span>
            <h2 class="module-title" style="font-size: 1.5rem; font-weight: 700; color: #1e293b;">@Model.ReportName</h2>
        </div>

        <div class="table-container" style="background: white; border: 1px solid #e2e8f0; border-radius: 8px; overflow: hidden;">
            <table style="width: 100%; border-collapse: collapse; text-align: left;">
                <thead style="background-color: #f8fafc; border-bottom: 1px solid #e2e8f0; color: #64748b; text-transform: uppercase; font-size: 0.75rem;">
                    <tr>
                        <th style="padding: 16px;">Order Status</th>
                        <th style="padding: 16px;">Total Orders</th>
                        <th style="padding: 16px;">Total Revenue (PKR)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Data)
                    {
                        <tr style="border-bottom: 1px solid #f1f5f9;">
                            <td style="padding: 16px; font-weight: 600; color: #0f172a;">@item.OrderStatus</td>
                            <td style="padding: 16px; color: #64748b;">@item.TotalOrders</td>
                            <td style="padding: 16px; font-weight: 700; color: #2563eb;">@item.TotalRevenue.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div style="background-color: #fffbeb; color: #b45309; padding: 16px; border-radius: 8px;">
            No data was returned from the database.
        </div>
    }
</div>