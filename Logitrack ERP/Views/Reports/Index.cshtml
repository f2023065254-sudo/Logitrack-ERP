﻿@{
ViewData["Title"] = "Reports & Analytics";
}

<!-- Chart.js CDN for beautiful interactive graphs -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>
    /* CSS for clean PDF print preview */
    @@media print {
    .sidebar, .main-sidebar, .top-navbar, .left-sidebar, nav, button, .btn-add-warehouse {
    display: none !important;
    }

    .warehouse-management-wrapper {
    padding: 0 !important;
    background: white !important;
    margin: 0 !important;
    width: 100% !important;
    }

    body {
    background: white !important;
    }
    }
</style>

<div class="warehouse-management-wrapper" style="background-color: #f8fafc; padding: 20px;">
    <!-- Header -->
    <div class="module-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px;">
        <div>
            <h2 class="module-title" style="font-size: 24px; font-weight: 700; color: #1e293b; margin: 0;">Reports & Analytics</h2>
            <p class="module-subtitle" style="color: #64748b; margin: 5px 0 0 0;">View comprehensive analytics and generate custom reports</p>
        </div>
        <div>
            <!-- 🔥 UPDATED: Added click action and text span id -->
            <button class="btn-add-warehouse" onclick="downloadPDFReport()" style="background-color: #2563eb; border: none; padding: 10px 20px; border-radius: 6px; color: white; cursor: pointer; font-weight: 600; display: flex; align-items: center; gap: 8px;">
                <i class="fa-solid fa-file-pdf"></i> <span id="exportText">Export Report</span>
            </button>
        </div>
    </div>

    <!-- 1. TOP METRICS CARDS -->
    <div class="metrics-row" style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-bottom: 25px;">
        <div class="metric-card" style="background: white; padding: 20px; border-radius: 8px; border: 1px solid #e2e8f0;">
            <p class="metric-label" style="color: #64748b; font-size: 13px; margin: 0 0 10px 0;">Total Revenue</p>
            <h3 class="metric-value" style="font-size: 24px; color: #10b981; margin: 0;">PKR 1.46M</h3>
        </div>
        <div class="metric-card" style="background: white; padding: 20px; border-radius: 8px; border: 1px solid #e2e8f0;">
            <p class="metric-label" style="color: #64748b; font-size: 13px; margin: 0 0 10px 0;">Total Orders</p>
            <h3 class="metric-value" style="font-size: 24px; color: #2563eb; margin: 0;">3,190</h3>
        </div>
        <div class="metric-card" style="background: white; padding: 20px; border-radius: 8px; border: 1px solid #e2e8f0;">
            <p class="metric-label" style="color: #64748b; font-size: 13px; margin: 0 0 10px 0;">On-Time Delivery</p>
            <h3 class="metric-value" style="font-size: 24px; color: #8b5cf6; margin: 0;">94.2%</h3>
        </div>
        <div class="metric-card" style="background: white; padding: 20px; border-radius: 8px; border: 1px solid #e2e8f0;">
            <p class="metric-label" style="color: #64748b; font-size: 13px; margin: 0 0 10px 0;">Employee Productivity</p>
            <h3 class="metric-value" style="font-size: 24px; color: #f59e0b; margin: 0;">90%</h3>
        </div>
    </div>

    <!-- 2. CHARTS GRID BLOCK -->
    <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 20px; margin-bottom: 25px;">
        <!-- Line Graph Card -->
        <div style="background: white; padding: 20px; border-radius: 8px; border: 1px solid #e2e8f0;">
            <h4 style="margin: 0 0 15px 0; font-size: 14px; color: #1e293b;">Monthly Performance Trends</h4>
            <div style="height: 250px;"><canvas id="performanceChart"></canvas></div>
        </div>
        <!-- Pie Chart Card -->
        <div style="background: white; padding: 20px; border-radius: 8px; border: 1px solid #e2e8f0;">
            <h4 style="margin: 0 0 15px 0; font-size: 14px; color: #1e293b;">Revenue Distribution</h4>
            <div style="height: 250px; display: flex; justify-content: center;"><canvas id="revenuePieChart"></canvas></div>
        </div>
    </div>

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 25px;">
        <!-- Bar Chart Card -->
        <div style="background: white; padding: 20px; border-radius: 8px; border: 1px solid #e2e8f0;">
            <h4 style="margin: 0 0 15px 0; font-size: 14px; color: #1e293b;">Department Performance</h4>
            <div style="height: 220px;"><canvas id="departmentBarChart"></canvas></div>
        </div>
        <!-- Customer Satisfaction Card -->
        <div style="background: white; padding: 20px; border-radius: 8px; border: 1px solid #e2e8f0;">
            <h4 style="margin: 0 0 15px 0; font-size: 14px; color: #1e293b;">Customer Satisfaction Trend</h4>
            <div style="height: 220px;"><canvas id="satisfactionLineChart"></canvas></div>
        </div>
    </div>

    <!-- 3. AVAILABLE REPORTS LIST -->
    <div class="orders-table-card" style="background: white; border-radius: 8px; border: 1px solid #e2e8f0; padding: 15px;">
        <h4 style="margin: 0 0 15px 0; font-size: 14px; color: #1e293b;">Available Reports</h4>
        <table class="orders-data-table" style="width: 100%; border-collapse: collapse;">
            <thead>
                <tr style="background-color: #f8fafc; text-align: left; font-size: 12px; color: #64748b;">
                    <th style="padding: 12px;">REPORT NAME</th>
                    <th>TYPE</th>
                    <th>GENERATED DATE</th>
                    <th>STATUS</th>
                    <th style="text-align: center;">ACTIONS</th>
                </tr>
            </thead>
            <tbody style="font-size: 13px; color: #334155;">
                <tr style="border-top: 1px solid #f1f5f9;">
                    <td style="padding: 12px;" class="text-bold">Monthly Order Summary</td>
                    <td><span style="background: #e0f2fe; color: #0369a1; padding: 2px 8px; border-radius: 4px; font-size: 11px;">Orders</span></td>
                    <td>2026-05-31</td>
                    <td><span style="color: #10b981; font-weight: 600;">Ready</span></td>
                    <td style="text-align: center;"><a href="javascript:void(0);" onclick="window.print();" style="color: #2563eb;"><i class="fa-solid fa-download"></i></a></td>
                </tr>
                <tr style="border-top: 1px solid #f1f5f9;">
                    <td style="padding: 12px;" class="text-bold">Financial Statement Q1</td>
                    <td><span style="background: #dcfce7; color: #15803d; padding: 2px 8px; border-radius: 4px; font-size: 11px;">Finance</span></td>
                    <td>2026-05-15</td>
                    <td><span style="color: #10b981; font-weight: 600;">Ready</span></td>
                    <td style="text-align: center;"><a href="javascript:void(0);" onclick="window.print();" style="color: #2563eb;"><i class="fa-solid fa-download"></i></a></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<!-- 📊 JAVASCRIPT FOR ENGINE CHARTS RENDERING -->
<script>
    // 1. Monthly Performance Trends (Area Chart)
    const ctxPerformance = document.getElementById('performanceChart').getContext('2d');
    new Chart(ctxPerformance, {
    type: 'line',
    data: {
    labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'],
    datasets: [{
    label: 'Orders Delivered',
    data: [340, 480, 520, 610, 750, 890],
    backgroundColor: 'rgba(37, 99, 235, 0.1)',
    borderColor: '#2563eb',
    borderWidth: 2,
    fill: true,
    tension: 0.3
    }]
    },
    options: { responsive: true, maintainAspectRatio: false }
    });

    // 2. Revenue Distribution (Pie Chart)
    const ctxPie = document.getElementById('revenuePieChart').getContext('2d');
    new Chart(ctxPie, {
    type: 'pie',
    data: {
    labels: ['Express Delivery', 'Standard Shipping', 'Warehousing', 'Special Handling'],
    datasets: [{
    data: [42, 30, 18, 10],
    backgroundColor: ['#2563eb', '#10b981', '#8b5cf6', '#f59e0b']
    }]
    },
    options: { responsive: true, maintainAspectRatio: false }
    });

    // 3. Department Performance (Bar Chart)
    const ctxBar = document.getElementById('departmentBarChart').getContext('2d');
    new Chart(ctxBar, {
    type: 'bar',
    data: {
    labels: ['Operations', 'Warehouse', 'Finance', 'Fleet', 'HR'],
    datasets: [{
    label: 'Performance %',
    data: [85, 78, 92, 80, 88],
    backgroundColor: '#3b82f6',
    borderRadius: 4
    }]
    },
    options: { responsive: true, maintainAspectRatio: false }
    });

    // 4. Customer Satisfaction Trend (Line Chart)
    const ctxSat = document.getElementById('satisfactionLineChart').getContext('2d');
    new Chart(ctxSat, {
    type: 'line',
    data: {
    labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'],
    datasets: [{
    label: 'Satisfaction Rating %',
    data: [88, 89, 91, 90, 93, 95],
    borderColor: '#10b981',
    borderWidth: 2,
    tension: 0.1,
    fill: false
    }]
    },
    options: { responsive: true, maintainAspectRatio: false }
    });

    // 🔥 NEW: Export Engine Functionality
    function downloadPDFReport() {
    const btnText = document.getElementById('exportText');
    btnText.innerText = "Generating PDF...";

    setTimeout(() => {
    window.print();
    btnText.innerText = "Export Report";
    }, 500);
    }
</script>