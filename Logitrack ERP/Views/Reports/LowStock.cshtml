@model Logitrack_ERP.Models.ReportApiResponse<Logitrack_ERP.Models.LowStockReportItem>
@{
    ViewData["Title"] = "Low Stock Report";
}

<div class="warehouse-management-wrapper" style="padding: 24px; background-color: #f8fafc; min-height: 100vh;">

    @if (ViewBag.ErrorMessage != null)
    {
        <div style="background-color: #fee2e2; color: #991b1b; padding: 16px; border-radius: 8px; margin-bottom: 20px;">
            <i class="fa-solid fa-triangle-exclamation"></i> @ViewBag.ErrorMessage
        </div>
    }
    else if (Model != null)
    {
        <div class="module-header" style="margin-bottom: 24px;">
            <span style="background-color: #eff6ff; color: #2563eb; padding: 6px 12px; border-radius: 20px; font-size: 0.8rem; font-weight: 700; margin-bottom: 12px; display: inline-block;">LIVE API DATA</span>
            <h2 class="module-title" style="font-size: 1.5rem; font-weight: 700; color: #1e293b; margin-bottom: 4px;">@Model.ReportName</h2>
            <p class="module-subtitle" style="color: #64748b; font-size: 0.95rem; margin: 0;">Total items requiring immediate restock: <strong>@Model.TotalItems</strong></p>
        </div>

        <div class="table-container" style="background: white; border: 1px solid #e2e8f0; border-radius: 8px; overflow: hidden;">
            <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.9rem;">
                <thead style="background-color: #f8fafc; border-bottom: 1px solid #e2e8f0; color: #64748b; text-transform: uppercase; font-size: 0.75rem;">
                    <tr>
                        <th style="padding: 16px;">Product ID</th>
                        <th style="padding: 16px;">Product Name</th>
                        <th style="padding: 16px;">Current Stock</th>
                        <th style="padding: 16px;">Measurement Unit</th>
                        <th style="padding: 16px;">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Data)
                    {
                        <tr style="border-bottom: 1px solid #f1f5f9;">
                            <td style="padding: 16px; font-weight: 600; color: #475569;">PRD-@item.ProductID.ToString("D3")</td>
                            <td style="padding: 16px; font-weight: 600; color: #0f172a;">@item.ProductName</td>
                            <td style="padding: 16px; font-weight: 700; color: #ea580c;">@item.StockQuantity</td>
                            <td style="padding: 16px; color: #64748b;">@item.Unit</td>
                            <td style="padding: 16px;">
                                <span style="background: #fef3c7; color: #b45309; padding: 4px 8px; border-radius: 4px; font-size: 0.8rem; font-weight: 600;">Critical Low</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>