@model Logitrack_ERP.Models.Employee
@{
    ViewData["Title"] = "Edit Employee";
}

<div class="warehouse-management-wrapper" style="padding: 24px;">
    <div class="module-header" style="margin-bottom: 24px;">
        <h2 class="module-title" style="font-size: 1.5rem; font-weight: 700; color: #1e293b;">Edit Employee Profile: @Model.EmployeeName</h2>
    </div>

    <div class="form-card-container" style="background: white; padding: 24px; border-radius: 8px; border: 1px solid #e2e8f0;">
        <form asp-action="Edit" method="post" class="figma-styled-form">

            <input type="hidden" name="EmployeeID" value="@Model.EmployeeID" />

            <div class="form-section">
                <h3 style="color: #374151; font-size: 1.1rem; margin-bottom: 16px; border-bottom: 1px solid #e2e8f0; padding-bottom: 8px;">Personal Information</h3>
                <div class="form-grid-3" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 24px;">
                    <div class="input-group">
                        <label style="display: block; font-weight: 600; margin-bottom: 8px; color: #475569;">Full Name</label>
                        <input type="text" name="EmployeeName" value="@Model.EmployeeName" class="form-control" style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px;" required />
                    </div>
                    <div class="input-group">
                        <label style="display: block; font-weight: 600; margin-bottom: 8px; color: #475569;">Phone Number</label>
                        <input type="text" name="Phone" value="@Model.Phone" class="form-control" style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px;" required />
                    </div>
                    <div class="input-group">
                        <label style="display: block; font-weight: 600; margin-bottom: 8px; color: #475569;">Email Address</label>
                        <input type="email" name="Email" value="@Model.Email" class="form-control" style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px;" required />
                    </div>
                </div>
            </div>

            <div class="form-section">
                <h3 style="color: #374151; font-size: 1.1rem; margin-bottom: 16px; border-bottom: 1px solid #e2e8f0; padding-bottom: 8px;">Job Details</h3>
                <div class="form-grid-3" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 24px;">
                    <div class="input-group">
                        <label style="display: block; font-weight: 600; margin-bottom: 8px; color: #475569;">Department</label>
                        <select name="Department" class="form-control" style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px;">
                            <option value="Logistics" selected="@(Model.Department == "Logistics")">Logistics & Operations</option>
                            <option value="Fleet Management" selected="@(Model.Department == "Fleet Management")">Fleet Management</option>
                            <option value="Finance" selected="@(Model.Department == "Finance")">Finance</option>
                            <option value="Human Resources" selected="@(Model.Department == "Human Resources")">Human Resources</option>
                            <option value="IT Support" selected="@(Model.Department == "IT Support")">IT Support</option>
                        </select>
                    </div>
                    <div class="input-group">
                        <label style="display: block; font-weight: 600; margin-bottom: 8px; color: #475569;">Job Position</label>
                        <input type="text" name="Position" value="@Model.Position" class="form-control" style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px;" required />
                    </div>
                    <div class="input-group">
                        <label style="display: block; font-weight: 600; margin-bottom: 8px; color: #475569;">Hire Date</label>
                        <input type="date" name="HireDate" value="@Model.HireDate" class="form-control" style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px;" required />
                    </div>
                    <div class="input-group">
                        <label style="display: block; font-weight: 600; margin-bottom: 8px; color: #475569;">Employment Status</label>
                        <select name="Status" class="form-control" style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px;">
                            <option value="Active" selected="@(Model.Status == "Active")">Active</option>
                            <option value="On Leave" selected="@(Model.Status == "On Leave")">On Leave</option>
                            <option value="Terminated" selected="@(Model.Status == "Terminated")">Terminated</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="form-actions-row" style="display: flex; justify-content: flex-end; gap: 12px; border-top: 1px solid #e5e7eb; padding-top: 20px;">
                <a asp-controller="HRM" asp-action="Index" class="btn-secondary-cancel" style="padding: 10px 20px; background-color: #f3f4f6; color: #374151; text-decoration: none; border-radius: 6px; font-weight: 500;">Cancel</a>
                <button type="submit" class="btn-primary-submit" style="padding: 10px 20px; background-color: #2563eb; color: white; border: none; border-radius: 6px; font-weight: 500; cursor: pointer;">Update Employee</button>
            </div>
        </form>
    </div>
</div>