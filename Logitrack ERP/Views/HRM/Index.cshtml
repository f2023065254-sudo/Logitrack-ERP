@model IEnumerable<Logitrack_ERP.Models.Employee>

@{
    ViewData["Title"] = "HR & Payroll";

    int totalEmployees = Model != null ? Model.Count() : 0;
    int activeStaff = Model != null ? Model.Count(e => e.Status == "Active") : 0;
    int onLeave = Model != null ? Model.Count(e => e.Status == "On Leave") : 0;

    // Count how many are in the Logistics department as an example metric
    int logisticsStaff = Model != null ? Model.Count(e => e.Department == "Logistics") : 0;
}

<div class="warehouse-management-wrapper" style="padding: 24px; background-color: #f8fafc; min-height: 100vh;">

    <div class="module-header" style="margin-bottom: 24px;">
        <h2 class="module-title" style="font-size: 1.5rem; font-weight: 700; color: #1e293b; margin-bottom: 4px;">Human Resources</h2>
        <p class="module-subtitle" style="color: #64748b; font-size: 0.95rem; margin: 0;">Manage employee records, departments, and payroll statuses</p>
    </div>

    <div class="dashboard-cards" style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-bottom: 32px;">
        <div class="stat-card" style="background: white; padding: 20px; border-radius: 8px; border: 1px solid #e2e8f0;">
            <p style="color: #64748b; font-size: 0.85rem; font-weight: 600; margin-bottom: 4px;">Total Employees</p>
            <h3 style="color: #0f172a; font-size: 1.8rem; font-weight: 700; margin: 0;">@totalEmployees</h3>
        </div>
        <div class="stat-card" style="background: white; padding: 20px; border-radius: 8px; border: 1px solid #e2e8f0;">
            <p style="color: #64748b; font-size: 0.85rem; font-weight: 600; margin-bottom: 4px;">Active Staff</p>
            <h3 style="color: #10b981; font-size: 1.8rem; font-weight: 700; margin: 0;">@activeStaff</h3>
        </div>
        <div class="stat-card" style="background: white; padding: 20px; border-radius: 8px; border: 1px solid #e2e8f0;">
            <p style="color: #64748b; font-size: 0.85rem; font-weight: 600; margin-bottom: 4px;">On Leave</p>
            <h3 style="color: #f59e0b; font-size: 1.8rem; font-weight: 700; margin: 0;">@onLeave</h3>
        </div>
        <div class="stat-card" style="background: white; padding: 20px; border-radius: 8px; border: 1px solid #e2e8f0;">
            <p style="color: #64748b; font-size: 0.85rem; font-weight: 600; margin-bottom: 4px;">Logistics & Fleet Staff</p>
            <h3 style="color: #3b82f6; font-size: 1.8rem; font-weight: 700; margin: 0;">@logisticsStaff</h3>
        </div>
    </div>

    <div class="tabs-container" style="border-bottom: 2px solid #e2e8f0; margin-bottom: 20px; display: flex; gap: 24px;">
        <a asp-controller="HRM" asp-action="Index" style="text-decoration: none; color: #2563eb; font-weight: 600; padding-bottom: 12px; border-bottom: 2px solid #2563eb; margin-bottom: -2px;">Employees</a>
        <a asp-controller="HRM" asp-action="Payroll" style="text-decoration: none; color: #64748b; font-weight: 500; padding-bottom: 12px;">Payroll Management</a>
    </div>

    <div class="actions-bar" style="display: flex; justify-content: flex-end; margin-bottom: 20px;">
        <a asp-action="Create" style="background-color: #2563eb; color: white; padding: 10px 20px; border-radius: 6px; text-decoration: none; font-weight: 600;">
            <i class="fa-solid fa-user-plus"></i> Add Employee
        </a>
    </div>

    <div class="table-container" style="background: white; border: 1px solid #e2e8f0; border-radius: 8px; overflow: hidden;">
        <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.9rem;">
            <thead style="background-color: #f8fafc; border-bottom: 1px solid #e2e8f0; color: #64748b; text-transform: uppercase; font-size: 0.75rem;">
                <tr>
                    <th style="padding: 16px;">EMP ID</th>
                    <th style="padding: 16px;">Employee Name</th>
                    <th style="padding: 16px;">Department</th>
                    <th style="padding: 16px;">Position</th>
                    <th style="padding: 16px;">Contact Info</th>
                    <th style="padding: 16px;">Status</th>
                    <th style="padding: 16px; text-align: right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr style="border-bottom: 1px solid #f1f5f9;">
                            <td style="padding: 16px; font-weight: 600; color: #475569;">EMP-@item.EmployeeID.ToString("D3")</td>
                            <td style="padding: 16px; font-weight: 600; color: #0f172a;">@item.EmployeeName</td>
                            <td style="padding: 16px; color: #64748b;">@item.Department</td>
                            <td style="padding: 16px; color: #64748b;">@item.Position</td>
                            <td style="padding: 16px;">
                                <div style="color: #0f172a; font-size: 0.85rem;">@item.Phone</div>
                                <div style="color: #64748b; font-size: 0.8rem;">@item.Email</div>
                            </td>
                            <td style="padding: 16px;">
                                @if (item.Status == "Active")
                                {
                                    <span style="background: #d1fae5; color: #065f46; padding: 4px 8px; border-radius: 12px; font-size: 0.8rem; font-weight: 600;">Active</span>
                                }
                                else if (item.Status == "On Leave")
                                {

                                    <span style="background: #fef3c7; color: #b45309; padding: 4px 8px; border-radius: 12px; font-size: 0.8rem; font-weight: 600;">On Leave</span>
                                }
                                else
                                {

                                    <span style="background: #fee2e2; color: #991b1b; padding: 4px 8px; border-radius: 12px; font-size: 0.8rem; font-weight: 600;">Terminated</span>
                                }
                            </td>
                            <td style="padding: 16px; text-align: right;">
                                <a asp-action="Edit" asp-route-id="@item.EmployeeID" style="color: #10b981; margin-right: 12px;"><i class="fa-regular fa-pen-to-square"></i></a>
                                <a asp-action="Delete" asp-route-id="@item.EmployeeID" style="color: #ef4444;" onclick="return confirm('Delete this employee record?');"><i class="fa-regular fa-trash-can"></i></a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>