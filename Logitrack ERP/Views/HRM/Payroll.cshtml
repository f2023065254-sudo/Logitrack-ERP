@{
    ViewData["Title"] = "Payroll Management";
}

<div class="warehouse-management-wrapper">
    <div class="module-header">
        <h2 class="module-title">HRM & Payroll</h2>
        <p class="module-subtitle">Process monthly salaries and allowances distribution</p>
    </div>

    <div class="metrics-row">
        <div class="metric-card"><div class="metric-body"><p class="metric-label">Total Employees</p><h3 class="metric-value">5</h3></div></div>
        <div class="metric-card"><div class="metric-body"><p class="metric-label">Active Employees</p><h3 class="metric-value">4</h3></div></div>
        <div class="metric-card"><div class="metric-body"><p class="metric-label">Total Payroll</p><h3 class="metric-value" style="color: #8b5cf6;">PKR 318K</h3></div></div>
        <div class="metric-card"><div class="metric-body"><p class="metric-label">Paid Payroll</p><h3 class="metric-value" style="color: #22c55e;">PKR 203K</h3></div></div>
    </div>

    <div class="warehouse-subtabs-row">
        <a asp-controller="HRM" asp-action="Index" class="subtab-btn-link">Employees</a>

        <a asp-controller="Manager" asp-action="Index" class="subtab-btn-link">Department Managers</a>

        <a asp-controller="HRM" asp-action="Payroll" class="subtab-btn-link active-tab">Payroll</a>
    </div>

    <div class="controls-bar">
        <div class="search-box-wrapper">
            <i class="fa-solid fa-magnifying-glass search-icon"></i>
            <input type="text" class="search-input" placeholder="Search payroll by employee..." />
        </div>
    </div>

    <div class="orders-table-card">
        <table class="orders-data-table">
            <thead>
                <tr>
                    <th>EMPLOYEE ID</th>
                    <th>NAME</th>
                    <th>DEPARTMENT</th>
                    <th>BASE SALARY</th>
                    <th>ALLOWANCES</th>
                    <th>NET SALARY</th>
                    <th>STATUS</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="text-bold">EMP-001</td>
                    <td class="text-bold">Ali Ahmed</td>
                    <td>Operations</td>
                    <td>PKR 95,000</td>
                    <td>PKR 10,000</td>
                    <td class="text-bold">PKR 105,000</td>
                    <td><span class="status-badge status-delivered">Paid</span></td>
                </tr>
                <tr>
                    <td class="text-bold">EMP-002</td>
                    <td class="text-bold">Sara Khan</td>
                    <td>Finance</td>
                    <td>PKR 85,000</td>
                    <td>PKR 5,000</td>
                    <td class="text-bold">PKR 90,000</td>
                    <td><span class="status-badge status-pending">Pending</span></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>