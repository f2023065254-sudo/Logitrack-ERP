@model Logitrack_ERP.Models.AttendanceSubmitViewModel

@{
    ViewData["Title"] = "Mark Daily Attendance";
}

<div class="warehouse-management-wrapper" style="padding: 24px; background-color: #f8fafc; min-height: 100vh;">

    <div class="module-header" style="margin-bottom: 24px; display: flex; justify-content: space-between; align-items: center;">
        <div>
            <h2 class="module-title" style="font-size: 1.5rem; font-weight: 700; color: #1e293b; margin-bottom: 4px;">Take Attendance</h2>
            <p class="module-subtitle" style="color: #64748b; font-size: 0.95rem; margin: 0;">Mark attendance for drivers and employees</p>
        </div>
        <a asp-action="Index" style="text-decoration: none; color: #2563eb; font-weight: 600;">Back to Records</a>
    </div>

    <form asp-action="MarkAttendance" method="post" style="background: white; border: 1px solid #e2e8f0; border-radius: 8px; padding: 20px;">

        <div style="margin-bottom: 20px;">
            <label style="font-weight: 600; color: #334155;">Attendance Date:</label>
            <input type="date" asp-for="AttendanceDate" class="form-control" style="padding: 8px; border: 1px solid #cbd5e1; border-radius: 4px; margin-left: 10px;" required />
        </div>

        <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.9rem;">
            <thead style="background-color: #f8fafc; border-bottom: 1px solid #e2e8f0; color: #64748b; text-transform: uppercase;">
                <tr>
                    <th style="padding: 16px;">Employee Name</th>
                    <th style="padding: 16px;">Role</th>
                    <th style="padding: 16px;">Attendance Status</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.AttendanceList.Count; i++)
                {
                    <tr style="border-bottom: 1px solid #f1f5f9;">
                        <td style="padding: 16px; font-weight: 600; color: #0f172a;">
                            @Model.AttendanceList[i].EmployeeName
                            <input type="hidden" asp-for="AttendanceList[i].UserID" />
                            <input type="hidden" asp-for="AttendanceList[i].EmployeeName" />
                        </td>
                        <td style="padding: 16px; color: #64748b;">
                            @Model.AttendanceList[i].Role
                            <input type="hidden" asp-for="AttendanceList[i].Role" />
                        </td>
                        <td style="padding: 16px;">
                            <select asp-for="AttendanceList[i].Status" style="padding: 8px; border: 1px solid #cbd5e1; border-radius: 4px; width: 150px;">
                                <option value="Present">✅ Present</option>
                                <option value="Absent">❌ Absent</option>
                                <option value="Leave">🏖️ Leave</option>
                            </select>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div style="margin-top: 25px; text-align: right;">
            <button type="submit" style="background-color: #2563eb; color: white; padding: 10px 25px; border: none; border-radius: 6px; font-weight: 600; cursor: pointer;">
                Save Attendance
            </button>
        </div>
    </form>
</div>