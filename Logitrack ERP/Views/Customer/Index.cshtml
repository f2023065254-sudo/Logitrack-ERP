@model IEnumerable<Logitrack_ERP.Models.Customer>
@{
    ViewData["Title"] = "Customer Management";
    int totalCustomers = Model != null ? Model.Count() : 0;
}

<div class="warehouse-management-wrapper" style="padding: 24px; background-color: #f8fafc; min-height: 100vh;">

    <div class="module-header" style="margin-bottom: 24px;">
        <h2 class="module-title" style="font-size: 1.5rem; font-weight: 700; color: #1e293b; margin-bottom: 4px;">Customer Directory</h2>
        <p class="module-subtitle" style="color: #64748b; font-size: 0.95rem; margin: 0;">Manage client profiles, contact information, and delivery addresses</p>
    </div>

    <div class="dashboard-cards" style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-bottom: 32px;">
        <div class="stat-card" style="background: white; padding: 20px; border-radius: 8px; border: 1px solid #e2e8f0;">
            <p style="color: #64748b; font-size: 0.85rem; font-weight: 600; margin-bottom: 4px;">Total Registered Clients</p>
            <h3 style="color: #0f172a; font-size: 1.8rem; font-weight: 700; margin: 0;">@totalCustomers</h3>
        </div>
    </div>

    <div class="tabs-container" style="border-bottom: 2px solid #e2e8f0; margin-bottom: 20px; display: flex; gap: 24px;">
        <a asp-controller="Orders" asp-action="Index" style="text-decoration: none; color: #64748b; font-weight: 500; padding-bottom: 12px;">Active Orders</a>
        <a asp-controller="Customer" asp-action="Index" style="text-decoration: none; color: #2563eb; font-weight: 600; padding-bottom: 12px; border-bottom: 2px solid #2563eb; margin-bottom: -2px;">Customers</a>
    </div>

    <div class="actions-bar" style="display: flex; justify-content: space-between; margin-bottom: 20px;">
        <div class="search-box" style="position: relative; width: 60%; max-width: 500px;">
            <i class="fa-solid fa-magnifying-glass" style="position: absolute; left: 16px; top: 12px; color: #94a3b8;"></i>
            <input type="text" placeholder="Search customers by name, email, or ID..." style="width: 100%; padding: 10px 10px 10px 42px; border: 1px solid #cbd5e1; border-radius: 6px; outline: none; font-size: 0.95rem;" />
        </div>

        <a asp-action="Create" style="background-color: #2563eb; color: white; padding: 10px 20px; border-radius: 6px; text-decoration: none; font-weight: 600; display: inline-flex; align-items: center; gap: 8px;">
            <i class="fa-solid fa-plus"></i> Add Customer
        </a>
    </div>

    <div class="table-container" style="background: white; border: 1px solid #e2e8f0; border-radius: 8px; overflow: hidden;">
        <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.9rem;">
            <thead style="background-color: #f8fafc; border-bottom: 1px solid #e2e8f0; color: #64748b; text-transform: uppercase; font-size: 0.75rem;">
                <tr>
                    <th style="padding: 16px;">Customer ID</th>
                    <th style="padding: 16px;">Full Name</th>
                    <th style="padding: 16px;">Contact Details</th>
                    <th style="padding: 16px;">Primary Address</th>
                    <th style="padding: 16px; text-align: right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr style="border-bottom: 1px solid #f1f5f9;">
                            <td style="padding: 16px; font-weight: 600; color: #475569;">CUST-@item.CustomerID.ToString("D3")</td>
                            <td style="padding: 16px; font-weight: 600; color: #0f172a;">@item.Name</td>
                            <td style="padding: 16px;">
                                <div style="color: #0f172a; font-size: 0.85rem;">@item.Phone</div>
                                <div style="color: #64748b; font-size: 0.8rem;">@item.Email</div>
                            </td>
                            <td style="padding: 16px; color: #64748b;">@item.Address</td>
                            <td style="padding: 16px; text-align: right;">
                                <a asp-action="Edit" asp-route-id="@item.CustomerID" style="color: #10b981; margin-right: 12px;"><i class="fa-regular fa-pen-to-square"></i></a>
                                <a asp-action="Delete" asp-route-id="@item.CustomerID" style="color: #ef4444;" onclick="return confirm('Delete this customer?');"><i class="fa-regular fa-trash-can"></i></a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>