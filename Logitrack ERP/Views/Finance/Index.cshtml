@model IEnumerable<Logitrack_ERP.Models.Invoice>

@{
    ViewData["Title"] = "Billing & Invoices";

    // Financial Analytics Math
    int totalInvoices = Model != null ? Model.Count() : 0;
    decimal totalRevenue = Model != null ? Model.Where(i => i.Status == "Paid").Sum(i => i.TotalAmount) : 0;
    decimal pendingReceivables = Model != null ? Model.Where(i => i.Status == "Unpaid").Sum(i => i.TotalAmount) : 0;
    int unpaidCount = Model != null ? Model.Count(i => i.Status == "Unpaid") : 0;
}

<div class="warehouse-management-wrapper" style="padding: 24px; background-color: #f8fafc; min-height: 100vh;">

    <div class="module-header" style="margin-bottom: 24px;">
        <h2 class="module-title" style="font-size: 1.5rem; font-weight: 700; color: #1e293b; margin-bottom: 4px;">Finance & Billing</h2>
        <p class="module-subtitle" style="color: #64748b; font-size: 0.95rem; margin: 0;">Manage customer invoices, track receivables, and process payments</p>
    </div>

    <div class="dashboard-cards" style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-bottom: 32px;">
        <div class="stat-card" style="background: white; padding: 20px; border-radius: 8px; border: 1px solid #e2e8f0;">
            <p style="color: #64748b; font-size: 0.85rem; font-weight: 600; margin-bottom: 4px;">Total Invoices Issued</p>
            <h3 style="color: #0f172a; font-size: 1.8rem; font-weight: 700; margin: 0;">@totalInvoices</h3>
        </div>
        <div class="stat-card" style="background: white; padding: 20px; border-radius: 8px; border: 1px solid #e2e8f0;">
            <p style="color: #64748b; font-size: 0.85rem; font-weight: 600; margin-bottom: 4px;">Revenue Collected</p>
            <h3 style="color: #10b981; font-size: 1.8rem; font-weight: 700; margin: 0;"><span style="font-size: 1rem; color: #94a3b8;">PKR</span> @totalRevenue.ToString("N0")</h3>
        </div>
        <div class="stat-card" style="background: white; padding: 20px; border-radius: 8px; border: 1px solid #e2e8f0;">
            <p style="color: #64748b; font-size: 0.85rem; font-weight: 600; margin-bottom: 4px;">Pending Receivables</p>
            <h3 style="color: #ef4444; font-size: 1.8rem; font-weight: 700; margin: 0;"><span style="font-size: 1rem; color: #94a3b8;">PKR</span> @pendingReceivables.ToString("N0")</h3>
        </div>
        <div class="stat-card" style="background: white; padding: 20px; border-radius: 8px; border: 1px solid #e2e8f0;">
            <p style="color: #64748b; font-size: 0.85rem; font-weight: 600; margin-bottom: 4px;">Unpaid Invoices</p>
            <h3 style="color: #f59e0b; font-size: 1.8rem; font-weight: 700; margin: 0;">@unpaidCount</h3>
        </div>
    </div>

    <div class="tabs-container" style="border-bottom: 2px solid #e2e8f0; margin-bottom: 20px; display: flex; gap: 24px;">
        <a href="#" style="text-decoration: none; color: #2563eb; font-weight: 600; padding-bottom: 12px; border-bottom: 2px solid #2563eb; margin-bottom: -2px;">Invoices</a>
    </div>

    <div class="actions-bar" style="display: flex; justify-content: flex-end; margin-bottom: 20px;">
        <a asp-action="Create" style="background-color: #2563eb; color: white; padding: 10px 20px; border-radius: 6px; text-decoration: none; font-weight: 600;">
            <i class="fa-solid fa-plus"></i> Generate Invoice
        </a>
    </div>
    <div style="margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center;">
        <h2>Financial Billing & Invoices</h2>

        <div>
            <a asp-controller="Finance" asp-action="ExportInvoicesCsv" class="btn btn-success" style="margin-right: 10px;">
                <i class="fa-solid fa-file-excel"></i> Export to Excel
            </a>
        </div>
    </div>

    <div class="table-container" style="background: white; border: 1px solid #e2e8f0; border-radius: 8px; overflow: hidden;">
        <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.9rem;">
            <thead style="background-color: #f8fafc; border-bottom: 1px solid #e2e8f0; color: #64748b; text-transform: uppercase; font-size: 0.75rem;">
                <tr>
                    <th style="padding: 16px;">Invoice No.</th>
                    <th style="padding: 16px;">Order Ref</th>
                    <th style="padding: 16px;">Customer ID</th>
                    <th style="padding: 16px;">Issue Date</th>
                    <th style="padding: 16px;">Amount (PKR)</th>
                    <th style="padding: 16px;">Status</th>
                    <th style="padding: 16px; text-align: right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr style="border-bottom: 1px solid #f1f5f9;">
                            <td style="padding: 16px; font-weight: 600; color: #475569;">INV-@item.InvoiceID.ToString("D4")</td>
                            <td style="padding: 16px; color: #64748b;">ORD-@item.OrderID.ToString("D4")</td>
                            <td style="padding: 16px; font-weight: 600; color: #0f172a;">CUST-@item.CustomerID.ToString("D3")</td>
                            <td style="padding: 16px; color: #64748b;">@item.InvoiceDate</td>
                            <td style="padding: 16px; font-weight: 600; color: #0f172a;">@item.TotalAmount.ToString("N2")</td>
                            <td style="padding: 16px;">
                                @if (item.Status == "Paid")
                                {
                                    <span style="background: #d1fae5; color: #065f46; padding: 4px 8px; border-radius: 12px; font-size: 0.8rem; font-weight: 600;">Paid</span>
                                }
                                else if (item.Status == "Unpaid")
                                {

                                    <span style="background: #fee2e2; color: #991b1b; padding: 4px 8px; border-radius: 12px; font-size: 0.8rem; font-weight: 600;">Unpaid</span>
                                }
                                else
                                {

                                    <span style="background: #fef3c7; color: #b45309; padding: 4px 8px; border-radius: 12px; font-size: 0.8rem; font-weight: 600;">@item.Status</span>
                                }
                            </td>
                            <td style="padding: 16px; text-align: right;">
                                <a asp-action="Edit" asp-route-id="@item.InvoiceID" style="color: #10b981; margin-right: 12px;"><i class="fa-regular fa-pen-to-square"></i></a>
                                <a asp-action="Delete" asp-route-id="@item.InvoiceID" style="color: #ef4444;" onclick="return confirm('Delete this invoice?');"><i class="fa-regular fa-trash-can"></i></a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>