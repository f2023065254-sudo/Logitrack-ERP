@{
    ViewData["Title"] = "Create Invoice";
}

<div class="orders-management-wrapper">
    <div class="module-header">
        <h2 class="module-title">Create New Invoice</h2>
        <p class="module-subtitle">Generate a financial statement and invoice record for an order</p>
    </div>

    <div class="form-card-container">
        <form class="figma-styled-form">
            <div class="form-section">
                <h3 class="section-subtitle"><i class="fa-solid fa-file-invoice-dollar"></i> Basic Information</h3>
                <div class="form-grid-3">
                    <div class="input-group">
                        <label class="form-label">Linked Order ID</label>
                        <input type="text" class="form-control-input" placeholder="e.g. ORD-1238" required />
                    </div>
                    <div class="input-group">
                        <label class="form-label">Customer Name</label>
                        <input type="text" class="form-control-input" placeholder="e.g. Ayesha Malik" required />
                    </div>
                    <div class="input-group">
                        <label class="form-label">Total Amount (PKR)</label>
                        <input type="number" class="form-control-input" placeholder="e.g. 18500" required />
                    </div>
                </div>
            </div>

            <div class="form-section">
                <h3 class="section-subtitle"><i class="fa-solid fa-calendar-days"></i> Timeline & Statement</h3>
                <div class="form-grid-3">
                    <div class="input-group">
                        <label class="form-label">Invoice Date</label>
                        <input type="date" class="form-control-input" value="2026-05-31" />
                    </div>
                    <div class="input-group">
                        <label class="form-label">Due Date</label>
                        <input type="date" class="form-control-input" value="2026-06-15" />
                    </div>
                    <div class="input-group">
                        <label class="form-label">Status</label>
                        <select class="form-control-select">
                            <option value="Pending">Pending</option>
                            <option value="Paid">Paid</option>
                            <option value="Overdue">Overdue</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="form-actions-row">
                <a asp-controller="Finance" asp-action="Index" class="btn-secondary-cancel">Cancel</a>
                <button type="submit" class="btn-primary-submit"><i class="fa-solid fa-check"></i> Generate Invoice</button>
            </div>
        </form>
    </div>
</div>