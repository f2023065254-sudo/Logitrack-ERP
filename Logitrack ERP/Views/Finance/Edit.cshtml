@model Logitrack_ERP.Models.Invoice
@{
    ViewData["Title"] = "Update Invoice";
}

<div class="warehouse-management-wrapper" style="padding: 24px;">
    <div class="module-header" style="margin-bottom: 24px;">
        <h2 class="module-title" style="font-size: 1.5rem; font-weight: 700; color: #1e293b;">Update Invoice: INV-@Model.InvoiceID.ToString("D4")</h2>
    </div>

    <div class="form-card-container" style="background: white; padding: 24px; border-radius: 8px; border: 1px solid #e2e8f0;">
        <form asp-action="Edit" method="post" class="figma-styled-form">

            <input type="hidden" name="InvoiceID" value="@Model.InvoiceID" />

            <div class="form-grid-3" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 20px;">

                <div class="input-group">
                    <label style="display: block; font-weight: 600; margin-bottom: 8px; color: #475569;">Linked Order ID</label>
                    <input type="number" name="OrderID" value="@Model.OrderID" class="form-control" style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px;" required />
                </div>

                <div class="input-group">
                    <label style="display: block; font-weight: 600; margin-bottom: 8px; color: #475569;">Customer ID</label>
                    <input type="number" name="CustomerID" value="@Model.CustomerID" class="form-control" style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px;" required />
                </div>

                <div class="input-group">
                    <label style="display: block; font-weight: 600; margin-bottom: 8px; color: #475569;">Total Amount (PKR)</label>
                    <input type="number" step="0.01" name="TotalAmount" value="@Model.TotalAmount" class="form-control" style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px;" required />
                </div>

                <div class="input-group">
                    <label style="display: block; font-weight: 600; margin-bottom: 8px; color: #475569;">Issue Date</label>
                    <input type="date" name="InvoiceDate" value="@Model.InvoiceDate" class="form-control" style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px;" required />
                </div>

                <div class="input-group">
                    <label style="display: block; font-weight: 600; margin-bottom: 8px; color: #475569;">Due Date</label>
                    <input type="date" name="DueDate" value="@Model.DueDate" class="form-control" style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px;" required />
                </div>

                <div class="input-group">
                    <label style="display: block; font-weight: 600; margin-bottom: 8px; color: #475569;">Payment Status</label>
                    <select name="Status" class="form-control" style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px;">
                        <option value="Unpaid" selected="@(Model.Status == "Unpaid")">Unpaid</option>
                        <option value="Paid" selected="@(Model.Status == "Paid")">Paid</option>
                        <option value="Partial" selected="@(Model.Status == "Partial")">Partial</option>
                    </select>
                </div>
            </div>

            <div class="form-actions-row" style="display: flex; justify-content: flex-end; gap: 12px; border-top: 1px solid #e5e7eb; padding-top: 20px;">
                <a asp-controller="Finance" asp-action="Index" class="btn-secondary-cancel" style="padding: 10px 20px; background-color: #f3f4f6; color: #374151; text-decoration: none; border-radius: 6px; font-weight: 500;">Cancel</a>
                <button type="submit" class="btn-primary-submit" style="padding: 10px 20px; background-color: #2563eb; color: white; border: none; border-radius: 6px; font-weight: 500; cursor: pointer;">Update Invoice</button>
            </div>
        </form>
    </div>
</div>