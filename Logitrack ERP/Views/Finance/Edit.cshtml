@{
    ViewData["Title"] = "Modify Invoice";
}

<div class="orders-management-wrapper">
    <div class="module-header">
        <h2 class="module-title">Edit Invoice: INV-1002</h2>
        <p class="module-subtitle">Update financial parameters or update settlement statuses</p>
    </div>

    <div class="form-card-container">
        <form class="figma-styled-form">
            <div class="form-section">
                <h3 class="section-subtitle"><i class="fa-solid fa-file-invoice-dollar"></i> Invoice Statement Info</h3>
                <div class="form-grid-3">
                    <div class="input-group">
                        <label class="form-label">Linked Order ID</label>
                        <input type="text" class="form-control-input" value="ORD-1235" readonly style="background-color: #f1f5f9;" />
                    </div>
                    <div class="input-group">
                        <label class="form-label">Customer Name</label>
                        <input type="text" class="form-control-input" value="Fatima Ali" required />
                    </div>
                    <div class="input-group">
                        <label class="form-label">Total Amount (PKR)</label>
                        <input type="text" class="form-control-input" value="8,750" required />
                    </div>
                </div>
            </div>

            <div class="form-section">
                <h3 class="section-subtitle"><i class="fa-solid fa-calendar-days"></i> Timeline & Statement</h3>
                <div class="form-grid-3">
                    <div class="input-group">
                        <label class="form-label">Invoice Date</label>
                        <input type="date" class="form-control-input" value="2026-05-16" />
                    </div>
                    <div class="input-group">
                        <label class="form-label">Due Date</label>
                        <input type="date" class="form-control-input" value="2026-05-31" />
                    </div>
                    <div class="input-group">
                        <label class="form-label">Status</label>
                        <select class="form-control-select">
                            <option value="Pending" selected>Pending</option>
                            <option value="Paid">Paid</option>
                            <option value="Overdue">Overdue</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="form-actions-row">
                <a asp-controller="Finance" asp-action="Index" class="btn-secondary-cancel">Cancel Changes</a>
                <button type="submit" class="btn-primary-submit"><i class="fa-solid fa-arrows-rotate"></i> Update Invoice</button>
            </div>
        </form>
    </div>
</div>