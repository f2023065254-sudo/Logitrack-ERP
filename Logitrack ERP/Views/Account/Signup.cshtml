@model Logitrack_ERP.Models.SignupViewModel

@{
    Layout = null; // No sidebar on login/signup page
}

<div style="max-width: 400px; margin: 50px auto; font-family: 'Inter', sans-serif;">
    <h2 style="text-align:center; color:#1e293b;">Create Account</h2>

    @if (ViewBag.ErrorMessage != null)
    {
        <div style="background-color: #fee2e2; color: #dc2626; padding: 10px; border-radius: 5px; margin-bottom: 15px;">
            @ViewBag.ErrorMessage
        </div>
    }

    <form asp-action="Signup" method="post" style="background: white; padding: 30px; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.1);">

        <div style="margin-bottom: 15px;">
            <label>Username</label>
            <input asp-for="UserName" class="form-control" style="width:100%; padding:10px; margin-top:5px;" />
            <span asp-validation-for="UserName" style="color:red; font-size:12px;"></span>
        </div>

        <div style="margin-bottom: 15px;">
            <label>Email Address</label>
            <input asp-for="Email" type="email" class="form-control" style="width:100%; padding:10px; margin-top:5px;" />
            <span asp-validation-for="Email" style="color:red; font-size:12px;"></span>
        </div>

        <div style="margin-bottom: 15px;">
            <label>Password</label>
            <input asp-for="Password" type="password" class="form-control" style="width:100%; padding:10px; margin-top:5px;" />
            <span asp-validation-for="Password" style="color:red; font-size:12px;"></span>
            <small style="color:gray;">Must be 8+ chars, 1 uppercase, 1 lowercase, 1 special char.</small>
        </div>

        <div style="margin-bottom: 15px;">
            <label>Confirm Password</label>
            <input asp-for="ConfirmPassword" type="password" class="form-control" style="width:100%; padding:10px; margin-top:5px;" />
            <span asp-validation-for="ConfirmPassword" style="color:red; font-size:12px;"></span>
        </div>

        <div style="margin-bottom: 20px;">
            <label>Select Role</label>
            <select asp-for="Role" class="form-control" style="width:100%; padding:10px; margin-top:5px;">
                <option value="">-- Select Role --</option>
                <option value="Customer">Customer</option>
                <option value="Driver">Driver</option>
                <option value="Manager">Manager</option>
                <option value="Employee">Employee</option>
                <option value="Owner">Owner</option>
            </select>
            <span asp-validation-for="Role" style="color:red; font-size:12px;"></span>
        </div>

        <button type="submit" style="width: 100%; padding: 12px; background-color: #2563eb; color: white; border: none; border-radius: 5px; cursor: pointer;">Sign Up</button>

        <p style="text-align:center; margin-top:15px; font-size:14px;">
            Already have an account? <a asp-action="Login">Login here</a>
        </p>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}