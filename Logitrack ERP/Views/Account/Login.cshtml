@model Logitrack_ERP.Models.LoginViewModel

@{
    Layout = null; // Login page par sidebar aur navbar hide karne ke liye
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - Logitrack ERP</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body style="background-color: #f8fafc; display: flex; align-items: center; justify-content: center; height: 100vh; margin: 0;">

    <div style="width: 100%; max-width: 400px; padding: 20px; font-family: 'Inter', sans-serif;">

        <div style="text-align: center; margin-bottom: 30px;">
            <h1 style="color: #2563eb; font-weight: 800; margin: 0; font-size: 28px;">Logitrack ERP</h1>
            <p style="color: #64748b; margin-top: 5px;">Sign in to your account</p>
        </div>

        @if (ViewBag.ErrorMessage != null)
        {
            <div style="background-color: #fee2e2; color: #dc2626; padding: 12px; border-radius: 6px; margin-bottom: 20px; text-align: center; font-size: 14px; font-weight: 500;">
                @ViewBag.ErrorMessage
            </div>
        }

        @if (TempData["SuccessMessage"] != null)
        {
            <div style="background-color: #dcfce7; color: #16a34a; padding: 12px; border-radius: 6px; margin-bottom: 20px; text-align: center; font-size: 14px; font-weight: 500;">
                @TempData["SuccessMessage"]
            </div>
        }

        <form asp-action="Login" method="post" style="background: white; padding: 30px; border-radius: 12px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1), 0 2px 4px -1px rgba(0,0,0,0.06);">

            <div style="margin-bottom: 20px;">
                <label style="display: block; font-size: 14px; font-weight: 600; color: #334155; margin-bottom: 8px;">Email Address</label>
                <input asp-for="Email" type="email" placeholder="name@example.com" class="form-control" style="width: 100%; padding: 10px 12px; border: 1px solid #cbd5e1; border-radius: 6px; outline: none; box-sizing: border-box;" />
                <span asp-validation-for="Email" style="color: #ef4444; font-size: 12px; margin-top: 5px; display: block;"></span>
            </div>

            <div style="margin-bottom: 25px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                    <label style="font-size: 14px; font-weight: 600; color: #334155;">Password</label>
                </div>
                <input asp-for="Password" type="password" placeholder="••••••••" class="form-control" style="width: 100%; padding: 10px 12px; border: 1px solid #cbd5e1; border-radius: 6px; outline: none; box-sizing: border-box;" />
                <span asp-validation-for="Password" style="color: #ef4444; font-size: 12px; margin-top: 5px; display: block;"></span>
            </div>

            <button type="submit" style="width: 100%; padding: 12px; background-color: #2563eb; color: white; border: none; border-radius: 6px; font-size: 16px; font-weight: 600; cursor: pointer; transition: background-color 0.2s;">
                Sign In
            </button>

            <div style="margin-top: 25px; text-align: center; border-top: 1px solid #e2e8f0; padding-top: 20px;">
                <p style="color: #64748b; font-size: 14px; margin: 0 0 10px 0;">Don't have an account?</p>
                <a asp-action="Signup" style="display: inline-block; width: 100%; padding: 10px; background-color: white; color: #2563eb; border: 1px solid #2563eb; border-radius: 6px; text-decoration: none; font-size: 15px; font-weight: 600; text-align: center; transition: all 0.2s; box-sizing: border-box;">
                    Create New Account
                </a>
            </div>
        </form>
    </div>

    @section Scripts {
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }
    }
</body>
</html>