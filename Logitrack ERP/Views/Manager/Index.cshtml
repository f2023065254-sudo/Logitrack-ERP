@model IEnumerable<Logitrack_ERP.Models.Manager>
@{
    ViewData["Title"] = "Managers Dashboard";
}

<div class="warehouse-management-wrapper" style="padding: 24px; background-color: #f8fafc; min-height: 100vh;">
    <div class="module-header" style="margin-bottom: 24px;">
        <h2 class="module-title" style="font-size: 1.5rem; font-weight: 700; color: #1e293b;">Department Managers</h2>
        <p class="module-subtitle" style="color: #64748b;">Manage company executives and department leads.</p>
    </div>

    <div class="actions-bar" style="display: flex; justify-content: flex-end; margin-bottom: 20px;">
        <a asp-action="Create" style="background-color: #2563eb; color: white; padding: 10px 20px; border-radius: 6px; text-decoration: none; font-weight: 600;">
            <i class="fa-solid fa-plus"></i> Add New Manager
        </a>
    </div>

    <div class="table-container" style="background: white; border: 1px solid #e2e8f0; border-radius: 8px; overflow: hidden;">
        <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.9rem;">
            <thead style="background-color: #f8fafc; border-bottom: 1px solid #e2e8f0; color: #64748b; text-transform: uppercase; font-size: 0.75rem;">
                <tr>
                    <th style="padding: 16px;">ID</th>
                    <th style="padding: 16px;">Name</th>
                    <th style="padding: 16px;">Department</th>
                    <th style="padding: 16px;">Contact Info</th>
                    <th style="padding: 16px;">Status</th>
                    <th style="padding: 16px; text-align: right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr style="border-bottom: 1px solid #f1f5f9;">
                            <td style="padding: 16px; font-weight: 600;">MGR-@item.ManagerID</td>
                            <td style="padding: 16px; color: #0f172a; font-weight: bold;">@item.ManagerName</td>
                            <td style="padding: 16px; color: #64748b;">@item.Department</td>
                            <td style="padding: 16px; color: #64748b;">@item.Email<br><small>@item.Phone</small></td>
                            <td style="padding: 16px;">
                                <span style="background: @(item.Status == "Active" ? "#d1fae5" : "#fee2e2"); color: @(item.Status == "Active" ? "#065f46" : "#991b1b"); padding: 4px 8px; border-radius: 12px; font-size: 0.8rem; font-weight: 600;">
                                    @item.Status
                                </span>
                            </td>
                            <td style="padding: 16px; text-align: right;">
                                <a asp-action="Edit" asp-route-id="@item.ManagerID" style="color: #10b981; margin-right: 12px;"><i class="fa-regular fa-pen-to-square"></i></a>
                                <a asp-action="Delete" asp-route-id="@item.ManagerID" style="color: #ef4444;" onclick="return confirm('Delete this manager?');"><i class="fa-regular fa-trash-can"></i></a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>