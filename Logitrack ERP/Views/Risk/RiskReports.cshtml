@model IEnumerable<Logitrack_ERP.Models.RiskReport>

@{
    ViewData["Title"] = "Operational Risk Reports";

    // Dashboard calculations
    int totalRisks = Model != null ? Model.Count() : 0;
    int criticalRisks = Model != null ? Model.Count(r => r.Severity == "Critical") : 0;
    int openRisks = Model != null ? Model.Count(r => r.Status == "Investigating" || r.Status == "Escalated") : 0;
    int mitigatedRisks = Model != null ? Model.Count(r => r.Status == "Mitigated" || r.Status == "Resolved") : 0;
}

<div class="warehouse-management-wrapper" style="padding: 24px; background-color: #f8fafc; min-height: 100vh;">

    <div class="module-header" style="margin-bottom: 24px;">
        <h2 class="module-title" style="font-size: 1.5rem; font-weight: 700; color: #1e293b; margin-bottom: 4px;">Risk & Complaints Management</h2>
        <p class="module-subtitle" style="color: #64748b; font-size: 0.95rem; margin: 0;">Monitor and mitigate logistics supply chain risks</p>
    </div>

    <div class="dashboard-cards" style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-bottom: 32px;">
        <div class="stat-card" style="background: white; padding: 20px; border-radius: 8px; border: 1px solid #e2e8f0;">
            <p style="color: #64748b; font-size: 0.85rem; font-weight: 600; margin-bottom: 4px;">Total Tracked Risks</p>
            <h3 style="color: #0f172a; font-size: 1.8rem; font-weight: 700; margin: 0;">@totalRisks</h3>
        </div>
        <div class="stat-card" style="background: white; padding: 20px; border-radius: 8px; border: 1px solid #e2e8f0;">
            <p style="color: #64748b; font-size: 0.85rem; font-weight: 600; margin-bottom: 4px;">Open Incidents</p>
            <h3 style="color: #ea580c; font-size: 1.8rem; font-weight: 700; margin: 0;">@openRisks</h3>
        </div>
        <div class="stat-card" style="background: white; padding: 20px; border-radius: 8px; border: 1px solid #e2e8f0;">
            <p style="color: #64748b; font-size: 0.85rem; font-weight: 600; margin-bottom: 4px;">Critical Risks</p>
            <h3 style="color: #dc2626; font-size: 1.8rem; font-weight: 700; margin: 0;">@criticalRisks</h3>
        </div>
        <div class="stat-card" style="background: white; padding: 20px; border-radius: 8px; border: 1px solid #e2e8f0;">
            <p style="color: #64748b; font-size: 0.85rem; font-weight: 600; margin-bottom: 4px;">Mitigated Risks</p>
            <h3 style="color: #10b981; font-size: 1.8rem; font-weight: 700; margin: 0;">@mitigatedRisks</h3>
        </div>
    </div>

    <div class="tabs-container" style="border-bottom: 2px solid #e2e8f0; margin-bottom: 20px; display: flex; gap: 24px;">
        <a asp-controller="Risk" asp-action="Index" style="text-decoration: none; color: #64748b; font-weight: 500; padding-bottom: 12px;">Complaints</a>
        <a asp-controller="Risk" asp-action="RiskReports" style="text-decoration: none; color: #2563eb; font-weight: 600; padding-bottom: 12px; border-bottom: 2px solid #2563eb; margin-bottom: -2px;">Risk Reports</a>
    </div>

    <div class="actions-bar" style="display: flex; justify-content: space-between; margin-bottom: 20px;">
        <div class="search-box" style="position: relative; width: 60%; max-width: 500px;">
            <i class="fa-solid fa-magnifying-glass" style="position: absolute; left: 16px; top: 12px; color: #94a3b8;"></i>
            <input type="text" placeholder="Search risk incidents..." style="width: 100%; padding: 10px 10px 10px 42px; border: 1px solid #cbd5e1; border-radius: 6px; outline: none; font-size: 0.95rem;" />
        </div>

        <a asp-action="CreateRisk" style="background-color: #2563eb; color: white; padding: 10px 20px; border-radius: 6px; text-decoration: none; font-weight: 600; display: inline-flex; align-items: center; gap: 8px;">
            <i class="fa-solid fa-plus"></i> Log Risk
        </a>
    </div>

    <div class="table-container" style="background: white; border: 1px solid #e2e8f0; border-radius: 8px; overflow: hidden;">
        <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.9rem;">
            <thead style="background-color: #f8fafc; border-bottom: 1px solid #e2e8f0; color: #64748b; text-transform: uppercase; font-size: 0.75rem;">
                <tr>
                    <th style="padding: 16px;">Risk ID</th>
                    <th style="padding: 16px;">Incident Type</th>
                    <th style="padding: 16px;">Description</th>
                    <th style="padding: 16px;">Severity</th>
                    <th style="padding: 16px;">Mitigation Status</th>
                    <th style="padding: 16px;">Reported Date</th>
                    <th style="padding: 16px; text-align: right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr style="border-bottom: 1px solid #f1f5f9;">
                            <td style="padding: 16px; font-weight: 600; color: #475569;">RSK-@item.RiskID.ToString("D3")</td>
                            <td style="padding: 16px; font-weight: 600; color: #0f172a;">@item.RiskType</td>
                            <td style="padding: 16px; color: #64748b;">@item.Description</td>
                            <td style="padding: 16px;">
                                @if (item.Severity == "Critical")
                                {
                                    <span style="color: #dc2626; font-weight: 600;">Critical</span>
                                }
                                else if (item.Severity == "Medium")
                                {

                                    <span style="color: #ea580c; font-weight: 600;">Medium</span>
                                }
                                else
                                {

                                    <span style="color: #10b981; font-weight: 600;">Low</span>
                                }
                            </td>
                            <td style="padding: 16px; color: #0f172a;">@item.Status</td>
                            <td style="padding: 16px; color: #64748b;">@item.ReportedDate</td>
                            <td style="padding: 16px; text-align: right;">
                                <a asp-action="EditRisk" asp-route-id="@item.RiskID" style="color: #10b981; margin-right: 12px;"><i class="fa-regular fa-pen-to-square"></i></a>
                                <a asp-action="DeleteRisk" asp-route-id="@item.RiskID" style="color: #ef4444;" onclick="return confirm('Delete this risk record?');"><i class="fa-regular fa-trash-can"></i></a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>