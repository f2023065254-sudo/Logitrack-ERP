@model Logitrack_ERP.Models.Complaint
@{
    ViewData["Title"] = "Update Complaint";
}

<div class="warehouse-management-wrapper">
    <div class="module-header">
        <h2 class="module-title">Update Complaint: CMP-@Model.ComplaintID.ToString("D3")</h2>
    </div>

    <div class="form-card-container" style="background: white; padding: 24px; border-radius: 8px; border: 1px solid #e2e8f0;">
        <form asp-action="Edit" method="post" class="figma-styled-form">

            <input type="hidden" name="ComplaintID" value="@Model.ComplaintID" />
            <input type="hidden" name="CreatedDate" value="@Model.CreatedDate" />

            <div class="form-section">
                <div class="form-grid-3" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 20px;">
                    <div class="input-group">
                        <label style="display: block; font-weight: 600; margin-bottom: 8px; color: #475569;">Customer ID</label>
                        <input type="number" name="CustomerID" value="@Model.CustomerID" class="form-control" style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px;" required />
                    </div>
                    <div class="input-group">
                        <label style="display: block; font-weight: 600; margin-bottom: 8px; color: #475569;">Order Reference ID</label>
                        <input type="number" name="OrderID" value="@Model.OrderID" class="form-control" style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px;" required />
                    </div>
                    <div class="input-group">
                        <label style="display: block; font-weight: 600; margin-bottom: 8px; color: #475569;">Resolution Status</label>
                        <select name="Status" class="form-control" style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px;">
                            <option value="Open" selected="@(Model.Status == "Open")">Open</option>
                            <option value="In Progress" selected="@(Model.Status == "In Progress")">In Progress</option>
                            <option value="Escalated" selected="@(Model.Status == "Escalated")">Escalated</option>
                            <option value="Resolved" selected="@(Model.Status == "Resolved")">Resolved</option>
                        </select>
                    </div>
                </div>

                <div class="input-group" style="margin-bottom: 20px;">
                    <label style="display: block; font-weight: 600; margin-bottom: 8px; color: #475569;">Complaint Log Content</label>
                    <textarea name="ComplaintText" rows="4" class="form-control" style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px; font-family: inherit;" required>@Model.ComplaintText</textarea>
                </div>
            </div>

            <div class="form-actions-row" style="display: flex; justify-content: flex-end; gap: 12px; border-top: 1px solid #e5e7eb; padding-top: 20px;">
                <a asp-controller="Risk" asp-action="Index" class="btn-secondary-cancel" style="padding: 10px 20px; background-color: #f3f4f6; color: #374151; text-decoration: none; border-radius: 6px; font-weight: 500;">Cancel</a>
                <button type="submit" class="btn-primary-submit" style="padding: 10px 20px; background-color: #2563eb; color: white; border: none; border-radius: 6px; font-weight: 500; cursor: pointer;">Update Records</button>
            </div>
        </form>
    </div>
</div>