@model Logitrack_ERP.Models.Complaint
@{
    ViewData["Title"] = "Log Complaint";
}

<div class="warehouse-management-wrapper">
    <div class="module-header">
        <h2 class="module-title">Log Customer Complaint</h2>
        <p class="module-subtitle">Record customer service issues, feedback, or shipping claims</p>
    </div>

    <div class="form-card-container" style="background: white; padding: 24px; border-radius: 8px; border: 1px solid #e2e8f0;">
        <form asp-action="Create" method="post" class="figma-styled-form">
            <div class="form-section">
                <div class="form-grid-3" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 20px;">
                    <div class="input-group">
                        <label style="display: block; font-weight: 600; margin-bottom: 8px; color: #475569;">Customer Reference ID</label>
                        <input type="number" name="CustomerID" class="form-control" style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px;" placeholder="e.g. 1" required />
                    </div>
                    <div class="input-group">
                        <label style="display: block; font-weight: 600; margin-bottom: 8px; color: #475569;">Linked Order Reference ID</label>
                        <input type="number" name="OrderID" class="form-control" style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px;" placeholder="e.g. 1001" required />
                    </div>
                    <div class="input-group">
                        <label style="display: block; font-weight: 600; margin-bottom: 8px; color: #475569;">Initial Complaint Status</label>
                        <select name="Status" class="form-control" style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px;">
                            <option value="Open">Open (Unassigned)</option>
                            <option value="In Progress">In Progress</option>
                            <option value="Escalated">Escalated (Critical)</option>
                        </select>
                    </div>
                </div>

                <div class="input-group" style="margin-bottom: 20px;">
                    <label style="display: block; font-weight: 600; margin-bottom: 8px; color: #475569;">Detailed Complaint Text</label>
                    <textarea name="ComplaintText" rows="4" class="form-control" style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px; font-family: inherit;" placeholder="Describe customer grievance details completely..." required></textarea>
                </div>
            </div>

            <div class="form-actions-row" style="display: flex; justify-content: flex-end; gap: 12px; border-top: 1px solid #e5e7eb; padding-top: 20px;">
                <a asp-controller="Risk" asp-action="Index" class="btn-secondary-cancel" style="padding: 10px 20px; background-color: #f3f4f6; color: #374151; text-decoration: none; border-radius: 6px; font-weight: 500;">Cancel</a>
                <button type="submit" class="btn-primary-submit" style="padding: 10px 20px; background-color: #2563eb; color: white; border: none; border-radius: 6px; font-weight: 500; cursor: pointer;">File Complaint</button>
            </div>
        </form>
    </div>
</div>