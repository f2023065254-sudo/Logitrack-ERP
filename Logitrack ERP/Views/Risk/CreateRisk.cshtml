@model Logitrack_ERP.Models.RiskReport
@{
    ViewData["Title"] = "Log Risk Incident";
}

<div class="warehouse-management-wrapper" style="padding: 24px;">
    <div class="module-header" style="margin-bottom: 24px;">
        <h2 class="module-title" style="font-size: 1.5rem; font-weight: 700; color: #1e293b;">Log Risk Incident</h2>
    </div>

    <div class="form-card-container" style="background: white; padding: 24px; border-radius: 8px; border: 1px solid #e2e8f0;">
        <form asp-action="CreateRisk" method="post" class="figma-styled-form">
            <div class="form-section">
                <div class="form-grid-3" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 20px;">
                    <div class="input-group">
                        <label style="display: block; font-weight: 600; margin-bottom: 8px; color: #475569;">Linked Complaint ID</label>
                        <input type="number" name="ComplaintID" class="form-control" style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px;" placeholder="e.g. 1" required />
                    </div>
                    <div class="input-group">
                        <label style="display: block; font-weight: 600; margin-bottom: 8px; color: #475569;">Incident Type</label>
                        <input type="text" name="RiskType" class="form-control" style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px;" placeholder="e.g. Route Blockage" required />
                    </div>
                    <div class="input-group">
                        <label style="display: block; font-weight: 600; margin-bottom: 8px; color: #475569;">Severity Level</label>
                        <select name="Severity" class="form-control" style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px;">
                            <option value="Low">Low</option>
                            <option value="Medium">Medium</option>
                            <option value="Critical">Critical</option>
                        </select>
                    </div>
                </div>

                <div class="input-group" style="margin-bottom: 20px;">
                    <label style="display: block; font-weight: 600; margin-bottom: 8px; color: #475569;">Detailed Description</label>
                    <textarea name="Description" rows="3" class="form-control" style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px;" placeholder="Describe the risk incident..." required></textarea>
                </div>

                <div class="form-grid-3" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 20px;">
                    <div class="input-group">
                        <label style="display: block; font-weight: 600; margin-bottom: 8px; color: #475569;">Status (Mitigation)</label>
                        <input type="text" name="Status" class="form-control" style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px;" placeholder="e.g. Investigating" />
                    </div>
                    <div class="input-group">
                        <label style="display: block; font-weight: 600; margin-bottom: 8px; color: #475569;">Reported Date</label>
                        <input type="date" name="ReportedDate" class="form-control" style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px;" required />
                    </div>
                </div>
            </div>

            <div class="form-actions-row" style="display: flex; justify-content: flex-end; gap: 12px; border-top: 1px solid #e5e7eb; padding-top: 20px;">
                <a asp-controller="Risk" asp-action="RiskReports" class="btn-secondary-cancel" style="padding: 10px 20px; background-color: #f3f4f6; color: #374151; text-decoration: none; border-radius: 6px; font-weight: 500;">Cancel</a>
                <button type="submit" class="btn-primary-submit" style="padding: 10px 20px; background-color: #2563eb; color: white; border: none; border-radius: 6px; font-weight: 500; cursor: pointer;">Log Risk</button>
            </div>
        </form>
    </div>
</div>