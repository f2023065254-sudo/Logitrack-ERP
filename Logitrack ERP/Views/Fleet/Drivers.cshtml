@{
    ViewData["Title"] = "Fleet Drivers";
}

<div class="warehouse-management-wrapper">
    <div class="module-header">
        <h2 class="module-title">Fleet & Route Management</h2>
        <p class="module-subtitle">Manage registered commercial drivers and license status</p>
    </div>

    <div class="metrics-row">
        <div class="metric-card"><div class="metric-body"><p class="metric-label">Total Vehicles</p><h3 class="metric-value">4</h3></div></div>
        <div class="metric-card"><div class="metric-body"><p class="metric-label">Active Drivers</p><h3 class="metric-value">3</h3></div></div>
        <div class="metric-card"><div class="metric-body"><p class="metric-label">Active Routes</p><h3 class="metric-value">1</h3></div></div>
        <div class="metric-card"><div class="metric-body"><p class="metric-label">Total Distance (km)</p><h3 class="metric-value">665</h3></div></div>
    </div>

    <div class="warehouse-subtabs-row">
        <a asp-controller="Fleet" asp-action="Index" class="subtab-btn-link">Vehicles</a>
        <a asp-controller="Fleet" asp-action="Drivers" class="subtab-btn-link active-tab">Drivers</a>
        <a asp-controller="Fleet" asp-action="Routes" class="subtab-btn-link">Routes</a>
    </div>

    <div class="controls-bar">
        <div class="search-box-wrapper">
            <i class="fa-solid fa-magnifying-glass search-icon"></i>
            <input type="text" class="search-input" placeholder="Search drivers by name or ID..." />
        </div>
        <a asp-controller="Fleet" asp-action="CreateDriver" class="btn-add-warehouse">
            <i class="fa-solid fa-plus"></i> Add Driver
        </a>
    </div>

    <div class="orders-table-card">
        <table class="orders-data-table">
            <thead>
                <tr>
                    <th>DRIVER ID</th>
                    <th>DRIVER NAME</th>
                    <th>LICENSE NUMBER</th>
                    <th>CONTACT</th>
                    <th>STATUS</th>
                    <th>ASSIGNED VEHICLE</th>
                    <th style="text-align: center;">ACTIONS</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="text-bold">DRV-001</td>
                    <td class="text-bold">Ali Ahmed</td>
                    <td>PK-LHR-88219</td>
                    <td class="text-muted">0300-1122334</td>
                    <td><span class="status-badge status-delivered">On Duty</span></td>
                    <td class="text-bold">LHR-1234</td>
                    <td>
                        <div class="actions-flex-cell">
                            <a asp-controller="Fleet" asp-action="EditDriver" class="action-icon-link edit-btn"><i class="fa-regular fa-pen-to-square"></i></a>
                            <a href="#" class="action-icon-link delete-btn"><i class="fa-regular fa-trash-can"></i></a>
                        </div>
                    </td>
                </tr>
                <tr>
                    <td class="text-bold">DRV-002</td>
                    <td class="text-bold">Hassan Raza</td>
                    <td>PK-KHI-44512</td>
                    <td class="text-muted">0321-9876543</td>
                    <td><span class="status-badge status-delivered">On Duty</span></td>
                    <td class="text-bold">KHI-5678</td>
                    <td>
                        <div class="actions-flex-cell">
                            <a href="#" class="action-icon-link edit-btn"><i class="fa-regular fa-pen-to-square"></i></a>
                            <a href="#" class="action-icon-link delete-btn"><i class="fa-regular fa-trash-can"></i></a>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>