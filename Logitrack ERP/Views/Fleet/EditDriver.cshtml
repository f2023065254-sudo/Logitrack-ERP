@{
    ViewData["Title"] = "Modify Driver Profile";
}

<div class="orders-management-wrapper">
    <div class="module-header">
        <h2 class="module-title">Edit Driver: DRV-001</h2>
        <p class="module-subtitle">Update contact details, status or renew license record</p>
    </div>

    <div class="form-card-container">
        <form class="figma-styled-form">
            <div class="form-section">
                <h3 class="section-subtitle"><i class="fa-solid fa-user-pen"></i> Update Personal Profile</h3>
                <div class="form-grid-3">
                    <div class="input-group">
                        <label class="form-label">Full Name</label>
                        <input type="text" class="form-control-input" value="Ali Ahmed" required />
                    </div>
                    <div class="input-group">
                        <label class="form-label">Contact Number</label>
                        <input type="tel" class="form-control-input" value="0300-1122334" required />
                    </div>
                    <div class="input-group">
                        <label class="form-label">CNIC Number</label>
                        <input type="text" class="form-control-input" value="35202-1111111-1" readonly style="background-color: #f1f5f9;" />
                    </div>
                </div>
            </div>

            <div class="form-section">
                <h3 class="section-subtitle"><i class="fa-solid fa-id-card"></i> License Verification</h3>
                <div class="form-grid-3">
                    <div class="input-group">
                        <label class="form-label">License Number</label>
                        <input type="text" class="form-control-input" value="PK-LHR-88219" required />
                    </div>
                    <div class="input-group">
                        <label class="form-label">License Type</label>
                        <select class="form-control-select">
                            <option value="HTV" selected>HTV (Heavy Commercial)</option>
                            <option value="LTV">LTV (Light Commercial)</option>
                        </select>
                    </div>
                    <div class="input-group">
                        <label class="form-label">Duty Status</label>
                        <select class="form-control-select">
                            <option value="On Duty" selected>On Duty</option>
                            <option value="Available">Available</option>
                            <option value="On Leave">On Leave</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="form-actions-row">
                <a asp-controller="Fleet" asp-action="Drivers" class="btn-secondary-cancel">Cancel Changes</a>
                <button type="submit" class="btn-primary-submit"><i class="fa-solid fa-arrows-rotate"></i> Update Driver</button>
            </div>
        </form>
    </div>
</div>