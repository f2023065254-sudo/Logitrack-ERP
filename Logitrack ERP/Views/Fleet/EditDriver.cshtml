@model Logitrack_ERP.Models.Driver
@{
    ViewData["Title"] = "Edit Driver";
}

<div class="warehouse-management-wrapper" style="padding: 24px;">
    <div class="module-header" style="margin-bottom: 24px;">
        <h2 class="module-title" style="font-size: 1.5rem; font-weight: 700; color: #1e293b;">Edit Driver Profile</h2>
    </div>

    <div class="form-card-container" style="background: white; padding: 24px; border-radius: 8px; border: 1px solid #e2e8f0;">
        <form asp-action="EditDriver" method="post" class="figma-styled-form">

            <input type="hidden" name="DriverID" value="@Model.DriverID" />

            <div class="form-grid-3" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 20px;">

                <div class="input-group">
                    <label style="display: block; font-weight: 600; margin-bottom: 8px; color: #475569;">Full Name</label>
                    <input type="text" name="DriverName" value="@Model.DriverName" class="form-control" style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px;" required />
                </div>

                <div class="input-group">
                    <label style="display: block; font-weight: 600; margin-bottom: 8px; color: #475569;">Contact Phone</label>
                    <input type="text" name="Phone" value="@Model.Phone" class="form-control" style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px;" required />
                </div>

                <div class="input-group">
                    <label style="display: block; font-weight: 600; margin-bottom: 8px; color: #475569;">License Number</label>
                    <input type="text" name="LicenseNumber" value="@Model.LicenseNumber" class="form-control" style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px;" required />
                </div>

                <div class="input-group">
                    <label style="display: block; font-weight: 600; margin-bottom: 8px; color: #475569;">Assigned Vehicle</label>
                    <input type="text" name="AssignedVehicle" value="@Model.AssignedVehicle" class="form-control" style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px;" required />
                </div>

                <div class="input-group">
                    <label style="display: block; font-weight: 600; margin-bottom: 8px; color: #475569;">Status</label>
                    <select name="Status" class="form-control" style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px;">
                        <option value="Available" selected="@(Model.Status == "Available")">Available</option>
                        <option value="On Route" selected="@(Model.Status == "On Route")">On Route</option>
                        <option value="Off Duty" selected="@(Model.Status == "Off Duty")">Off Duty</option>
                    </select>
                </div>
            </div>

            <div class="form-actions-row" style="display: flex; justify-content: flex-end; gap: 12px; border-top: 1px solid #e5e7eb; padding-top: 20px;">
                <a asp-controller="Fleet" asp-action="Drivers" class="btn-secondary-cancel" style="padding: 10px 20px; background-color: #f3f4f6; color: #374151; text-decoration: none; border-radius: 6px; font-weight: 500;">Cancel</a>
                <button type="submit" class="btn-primary-submit" style="padding: 10px 20px; background-color: #2563eb; color: white; border: none; border-radius: 6px; font-weight: 500; cursor: pointer;">Update Driver</button>
            </div>
        </form>
    </div>
</div>