@model IEnumerable<Logitrack_ERP.Models.Route>

@{
    ViewData["Title"] = "Fleet Routes";

    int totalRoutes = Model != null ? Model.Count() : 0;
    decimal totalDistance = Model != null ? Model.Sum(r => r.Distance) : 0;
    int unassignedRoutes = Model != null ? Model.Count(r => r.AssignedVehicle == "Unassigned" || string.IsNullOrEmpty(r.AssignedVehicle)) : 0;
}

<div class="warehouse-management-wrapper" style="padding: 24px; background-color: #f8fafc; min-height: 100vh;">

    <div class="module-header" style="margin-bottom: 24px;">
        <h2 class="module-title" style="font-size: 1.5rem; font-weight: 700; color: #1e293b; margin-bottom: 4px;">Fleet Management</h2>
        <p class="module-subtitle" style="color: #64748b; font-size: 0.95rem; margin: 0;">Map, assign, and track logistics delivery routes</p>
    </div>

    <div class="dashboard-cards" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 32px;">
        <div class="stat-card" style="background: white; padding: 20px; border-radius: 8px; border: 1px solid #e2e8f0;">
            <p style="color: #64748b; font-size: 0.85rem; font-weight: 600; margin-bottom: 4px;">Total Planned Routes</p>
            <h3 style="color: #0f172a; font-size: 1.8rem; font-weight: 700; margin: 0;">@totalRoutes</h3>
        </div>
        <div class="stat-card" style="background: white; padding: 20px; border-radius: 8px; border: 1px solid #e2e8f0;">
            <p style="color: #64748b; font-size: 0.85rem; font-weight: 600; margin-bottom: 4px;">Total Network Distance</p>
            <h3 style="color: #10b981; font-size: 1.8rem; font-weight: 700; margin: 0;">@totalDistance.ToString("N1") <span style="font-size: 1rem; color: #94a3b8;">km</span></h3>
        </div>
        <div class="stat-card" style="background: white; padding: 20px; border-radius: 8px; border: 1px solid #e2e8f0;">
            <p style="color: #64748b; font-size: 0.85rem; font-weight: 600; margin-bottom: 4px;">Routes Needing Vehicles</p>
            <h3 style="color: #ef4444; font-size: 1.8rem; font-weight: 700; margin: 0;">@unassignedRoutes</h3>
        </div>
    </div>

    <div class="tabs-container" style="border-bottom: 2px solid #e2e8f0; margin-bottom: 20px; display: flex; gap: 24px;">
        <a asp-controller="Fleet" asp-action="Index" style="text-decoration: none; color: #64748b; font-weight: 500; padding-bottom: 12px;">Vehicles</a>
        <a asp-controller="Fleet" asp-action="Drivers" style="text-decoration: none; color: #64748b; font-weight: 500; padding-bottom: 12px;">Drivers</a>
        <a asp-controller="Fleet" asp-action="Routes" style="text-decoration: none; color: #2563eb; font-weight: 600; padding-bottom: 12px; border-bottom: 2px solid #2563eb; margin-bottom: -2px;">Routes</a>
    </div>

    <div class="actions-bar" style="display: flex; justify-content: flex-end; margin-bottom: 20px;">
        <a asp-action="CreateRoute" style="background-color: #2563eb; color: white; padding: 10px 20px; border-radius: 6px; text-decoration: none; font-weight: 600;">
            <i class="fa-solid fa-plus"></i> Add Route
        </a>
    </div>

    <div class="table-container" style="background: white; border: 1px solid #e2e8f0; border-radius: 8px; overflow: hidden;">
        <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.9rem;">
            <thead style="background-color: #f8fafc; border-bottom: 1px solid #e2e8f0; color: #64748b; text-transform: uppercase; font-size: 0.75rem;">
                <tr>
                    <th style="padding: 16px;">Route ID</th>
                    <th style="padding: 16px;">Origin</th>
                    <th style="padding: 16px;">Destination</th>
                    <th style="padding: 16px;">Distance</th>
                    <th style="padding: 16px;">Est. Time</th>
                    <th style="padding: 16px;">Vehicle Assigned</th>
                    <th style="padding: 16px; text-align: right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr style="border-bottom: 1px solid #f1f5f9;">
                            <td style="padding: 16px; font-weight: 600; color: #475569;">RT-@item.RouteID.ToString("D3")</td>
                            <td style="padding: 16px; font-weight: 600; color: #0f172a;">@item.StartLocation</td>
                            <td style="padding: 16px; font-weight: 600; color: #0f172a;">@item.Destination</td>
                            <td style="padding: 16px; color: #64748b;">@item.Distance.ToString("N1") km</td>
                            <td style="padding: 16px; color: #64748b;">@item.EstimatedTime</td>
                            <td style="padding: 16px;">
                                @if (item.AssignedVehicle == "Unassigned" || string.IsNullOrEmpty(item.AssignedVehicle))
                                {
                                    <span style="background: #fee2e2; color: #991b1b; padding: 4px 8px; border-radius: 12px; font-size: 0.8rem; font-weight: 600;">Unassigned</span>
                                }
                                else
                                {
                                    <span style="background: #dbeafe; color: #1e40af; padding: 4px 8px; border-radius: 12px; font-size: 0.8rem; font-weight: 600;">@item.AssignedVehicle</span>
                                }
                            </td>
                            <td style="padding: 16px; text-align: right;">
                                <a asp-action="EditRoute" asp-route-id="@item.RouteID" style="color: #10b981; margin-right: 12px;"><i class="fa-regular fa-pen-to-square"></i></a>
                                <a asp-action="DeleteRoute" asp-route-id="@item.RouteID" style="color: #ef4444;" onclick="return confirm('Delete this route?');"><i class="fa-regular fa-trash-can"></i></a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>