@model IEnumerable<Logitrack_ERP.Models.Vehicle>

@{
    ViewData["Title"] = "Fleet Management";

    int totalVehicles = Model != null ? Model.Count() : 0;
    int availableVehicles = Model != null ? Model.Count(v => v.Status == "Available") : 0;
    int maintenanceVehicles = Model != null ? Model.Count(v => v.Status == "Maintenance") : 0;
    int activeVehicles = Model != null ? Model.Count(v => v.Status == "On Route") : 0;
}

<div class="warehouse-management-wrapper" style="padding: 24px; background-color: #f8fafc; min-height: 100vh;">

    <div class="module-header" style="margin-bottom: 24px;">
        <h2 class="module-title" style="font-size: 1.5rem; font-weight: 700; color: #1e293b; margin-bottom: 4px;">Fleet Management</h2>
        <p class="module-subtitle" style="color: #64748b; font-size: 0.95rem; margin: 0;">Manage vehicles, assignments, and maintenance schedules</p>
    </div>

    <div class="dashboard-cards" style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-bottom: 32px;">
        <div class="stat-card" style="background: white; padding: 20px; border-radius: 8px; border: 1px solid #e2e8f0;">
            <p style="color: #64748b; font-size: 0.85rem; font-weight: 600; margin-bottom: 4px;">Total Vehicles</p>
            <h3 style="color: #0f172a; font-size: 1.8rem; font-weight: 700; margin: 0;">@totalVehicles</h3>
        </div>
        <div class="stat-card" style="background: white; padding: 20px; border-radius: 8px; border: 1px solid #e2e8f0;">
            <p style="color: #64748b; font-size: 0.85rem; font-weight: 600; margin-bottom: 4px;">Available</p>
            <h3 style="color: #10b981; font-size: 1.8rem; font-weight: 700; margin: 0;">@availableVehicles</h3>
        </div>
        <div class="stat-card" style="background: white; padding: 20px; border-radius: 8px; border: 1px solid #e2e8f0;">
            <p style="color: #64748b; font-size: 0.85rem; font-weight: 600; margin-bottom: 4px;">On Route</p>
            <h3 style="color: #3b82f6; font-size: 1.8rem; font-weight: 700; margin: 0;">@activeVehicles</h3>
        </div>
        <div class="stat-card" style="background: white; padding: 20px; border-radius: 8px; border: 1px solid #e2e8f0;">
            <p style="color: #64748b; font-size: 0.85rem; font-weight: 600; margin-bottom: 4px;">In Maintenance</p>
            <h3 style="color: #ef4444; font-size: 1.8rem; font-weight: 700; margin: 0;">@maintenanceVehicles</h3>
        </div>
    </div>

    <div class="tabs-container" style="border-bottom: 2px solid #e2e8f0; margin-bottom: 20px; display: flex; gap: 24px;">
        <a asp-controller="Fleet" asp-action="Index" style="text-decoration: none; color: #2563eb; font-weight: 600; padding-bottom: 12px; border-bottom: 2px solid #2563eb; margin-bottom: -2px;">Vehicles</a>
        <a asp-controller="Fleet" asp-action="Drivers" style="text-decoration: none; color: #64748b; font-weight: 500; padding-bottom: 12px;">Drivers</a>
        <a asp-controller="Fleet" asp-action="Routes" style="text-decoration: none; color: #64748b; font-weight: 500; padding-bottom: 12px;">Routes</a>
    </div>

    <div class="actions-bar" style="display: flex; justify-content: flex-end; margin-bottom: 20px;">
        <a asp-action="Create" style="background-color: #2563eb; color: white; padding: 10px 20px; border-radius: 6px; text-decoration: none; font-weight: 600;">
            <i class="fa-solid fa-plus"></i> Add Vehicle
        </a>
    </div>

    <div class="table-container" style="background: white; border: 1px solid #e2e8f0; border-radius: 8px; overflow: hidden;">
        <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.9rem;">
            <thead style="background-color: #f8fafc; border-bottom: 1px solid #e2e8f0; color: #64748b; text-transform: uppercase; font-size: 0.75rem;">
                <tr>
                    <th style="padding: 16px;">Registration No.</th>
                    <th style="padding: 16px;">Type</th>
                    <th style="padding: 16px;">Capacity</th>
                    <th style="padding: 16px;">Assigned Driver</th>
                    <th style="padding: 16px;">Next Maintenance</th>
                    <th style="padding: 16px;">Status</th>
                    <th style="padding: 16px; text-align: right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr style="border-bottom: 1px solid #f1f5f9;">
                            <td style="padding: 16px; font-weight: 600; color: #0f172a;">@item.VehicleNumber</td>
                            <td style="padding: 16px; color: #64748b;">@item.VehicleType</td>
                            <td style="padding: 16px; color: #64748b;">@item.Capacity.ToString("N0") Tons</td>
                            <td style="padding: 16px; color: #64748b;">@item.CurrentDriver</td>
                            <td style="padding: 16px; color: #64748b;">@item.NextMaintenanceDate</td>
                            <td style="padding: 16px;">
                                @if (item.Status == "Available")
                                {
                                    <span style="background: #d1fae5; color: #065f46; padding: 4px 8px; border-radius: 12px; font-size: 0.8rem; font-weight: 600;">Available</span>
                                }
                                else if (item.Status == "On Route")
                                {

                                    <span style="background: #dbeafe; color: #1e40af; padding: 4px 8px; border-radius: 12px; font-size: 0.8rem; font-weight: 600;">On Route</span>
                                }
                                else
                                {

                                    <span style="background: #fee2e2; color: #991b1b; padding: 4px 8px; border-radius: 12px; font-size: 0.8rem; font-weight: 600;">Maintenance</span>
                                }
                            </td>
                            <td style="padding: 16px; text-align: right;">
                                <a asp-action="Edit" asp-route-id="@item.VehicleID" style="color: #10b981; margin-right: 12px;"><i class="fa-regular fa-pen-to-square"></i></a>
                                <a asp-action="Delete" asp-route-id="@item.VehicleID" style="color: #ef4444;" onclick="return confirm('Delete this vehicle?');"><i class="fa-regular fa-trash-can"></i></a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>