@model Logitrack_ERP.Models.Vehicle
@{
    ViewData["Title"] = "Edit Vehicle";
}

<div class="warehouse-management-wrapper" style="padding: 24px;">
    <div class="module-header" style="margin-bottom: 24px;">
        <h2 class="module-title" style="font-size: 1.5rem; font-weight: 700; color: #1e293b;">Edit Vehicle: @Model.VehicleNumber</h2>
    </div>

    <div class="form-card-container" style="background: white; padding: 24px; border-radius: 8px; border: 1px solid #e2e8f0;">
        <form asp-action="Edit" method="post" class="figma-styled-form">

            <input type="hidden" name="VehicleID" value="@Model.VehicleID" />

            <div class="form-grid-3" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 20px;">

                <div class="input-group">
                    <label style="display: block; font-weight: 600; margin-bottom: 8px; color: #475569;">Vehicle Number Plate</label>
                    <input type="text" name="VehicleNumber" value="@Model.VehicleNumber" class="form-control" style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px;" required />
                </div>

                <div class="input-group">
                    <label style="display: block; font-weight: 600; margin-bottom: 8px; color: #475569;">Vehicle Type</label>
                    <select name="VehicleType" class="form-control" style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px;">
                        <option value="Box Truck" selected="@(Model.VehicleType == "Box Truck")">Box Truck</option>
                        <option value="Refrigerated Van" selected="@(Model.VehicleType == "Refrigerated Van")">Refrigerated Van</option>
                        <option value="Flatbed Trailer" selected="@(Model.VehicleType == "Flatbed Trailer")">Flatbed Trailer</option>
                        <option value="Pickup" selected="@(Model.VehicleType == "Pickup")">Pickup</option>
                    </select>
                </div>

                <div class="input-group">
                    <label style="display: block; font-weight: 600; margin-bottom: 8px; color: #475569;">Load Capacity (Tons)</label>
                    <input type="number" step="0.1" name="Capacity" value="@Model.Capacity" class="form-control" style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px;" required />
                </div>

                <div class="input-group">
                    <label style="display: block; font-weight: 600; margin-bottom: 8px; color: #475569;">Current Driver Assignment</label>
                    <input type="text" name="CurrentDriver" value="@Model.CurrentDriver" class="form-control" style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px;" required />
                </div>

                <div class="input-group">
                    <label style="display: block; font-weight: 600; margin-bottom: 8px; color: #475569;">Status</label>
                    <select name="Status" class="form-control" style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px;">
                        <option value="Available" selected="@(Model.Status == "Available")">Available</option>
                        <option value="On Route" selected="@(Model.Status == "On Route")">On Route</option>
                        <option value="Maintenance" selected="@(Model.Status == "Maintenance")">Maintenance</option>
                    </select>
                </div>

                <div class="input-group">
                    <label style="display: block; font-weight: 600; margin-bottom: 8px; color: #475569;">Next Maintenance Date</label>
                    <input type="date" name="NextMaintenanceDate" value="@Model.NextMaintenanceDate" class="form-control" style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px;" required />
                </div>
            </div>

            <div class="form-actions-row" style="display: flex; justify-content: flex-end; gap: 12px; border-top: 1px solid #e5e7eb; padding-top: 20px;">
                <a asp-controller="Fleet" asp-action="Index" class="btn-secondary-cancel" style="padding: 10px 20px; background-color: #f3f4f6; color: #374151; text-decoration: none; border-radius: 6px; font-weight: 500;">Cancel</a>
                <button type="submit" class="btn-primary-submit" style="padding: 10px 20px; background-color: #2563eb; color: white; border: none; border-radius: 6px; font-weight: 500; cursor: pointer;">Update Vehicle</button>
            </div>
        </form>
    </div>
</div>