@model Logitrack_ERP.Models.Driver
@{
    ViewData["Title"] = "Register Driver";
}

<div class="warehouse-management-wrapper" style="padding: 24px;">
    <div class="module-header" style="margin-bottom: 24px;">
        <h2 class="module-title" style="font-size: 1.5rem; font-weight: 700; color: #1e293b;">Register New Driver</h2>
    </div>

    <div class="form-card-container" style="background: white; padding: 24px; border-radius: 8px; border: 1px solid #e2e8f0;">
        <form asp-action="CreateDriver" method="post" class="figma-styled-form">

            <div class="form-grid-3" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 20px;">

                <div class="input-group">
                    <label style="display: block; font-weight: 600; margin-bottom: 8px; color: #475569;">Full Name</label>
                    <input type="text" name="DriverName" class="form-control" style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px;" placeholder="e.g. Ahmed Raza" required />
                </div>

                <div class="input-group">
                    <label style="display: block; font-weight: 600; margin-bottom: 8px; color: #475569;">Contact Phone</label>
                    <input type="text" name="Phone" class="form-control" style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px;" placeholder="e.g. 0300-1234567" required />
                </div>

                <div class="input-group">
                    <label style="display: block; font-weight: 600; margin-bottom: 8px; color: #475569;">License Number (Unique)</label>
                    <input type="text" name="LicenseNumber" class="form-control" style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px;" placeholder="e.g. LHR-DL-990" required />
                </div>

                <div class="input-group">
                    <label style="display: block; font-weight: 600; margin-bottom: 8px; color: #475569;">Assigned Vehicle</label>
                    <input type="text" name="AssignedVehicle" value="Unassigned" class="form-control" style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px;" required />
                    <span style="font-size: 0.8rem; color: #94a3b8; margin-top: 4px; display: block;">Leave as 'Unassigned' if no vehicle is allocated yet.</span>
                </div>

                <div class="input-group">
                    <label style="display: block; font-weight: 600; margin-bottom: 8px; color: #475569;">Initial Status</label>
                    <select name="Status" class="form-control" style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px;">
                        <option value="Available">Available</option>
                        <option value="On Route">On Route</option>
                        <option value="Off Duty">Off Duty</option>
                    </select>
                </div>
            </div>

            <div class="form-actions-row" style="display: flex; justify-content: flex-end; gap: 12px; border-top: 1px solid #e5e7eb; padding-top: 20px;">
                <a asp-controller="Fleet" asp-action="Drivers" class="btn-secondary-cancel" style="padding: 10px 20px; background-color: #f3f4f6; color: #374151; text-decoration: none; border-radius: 6px; font-weight: 500;">Cancel</a>
                <button type="submit" class="btn-primary-submit" style="padding: 10px 20px; background-color: #2563eb; color: white; border: none; border-radius: 6px; font-weight: 500; cursor: pointer;">Save Driver</button>
            </div>
        </form>
    </div>
</div>