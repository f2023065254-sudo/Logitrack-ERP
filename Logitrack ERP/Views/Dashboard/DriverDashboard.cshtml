@{
    Layout = "_Layout"; ViewData["Title"] = "Driver Dashboard";
}
<div style="font-family: 'Inter', sans-serif; padding: 20px;">
    <h1 style="color: #0f172a; font-weight: 700;">Driver Duty Logs</h1>
    <p style="color: #64748b; margin-bottom: 30px;">Drive safely! Please check your current dispatch routing details below.</p>

    <div style="background: #1e293b; color: white; padding: 24px; border-radius: 12px; max-width: 500px;">
        <span style="color: #94a3b8; font-size: 12px; text-transform: uppercase; font-weight: 700;">Assigned Route</span>
        <h3 style="margin: 6px 0 16px 0; color: #38bdf8;">@ViewBag.TodayRoute</h3>

        <div style="border-top: 1px solid #334155; padding-top: 14px; font-size: 14px; color: #cbd5e1;">
            <p><i class="fa-solid fa-truck"></i> Vehicle Registered Number: <strong>@ViewBag.VehicleNo</strong></p>
        </div>
    </div>
</div>