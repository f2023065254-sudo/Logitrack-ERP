@{
    ViewData["Title"] = "Dashboard Overview";
}

<div class="dashboard-wrapper">

    <div class="metrics-row">
        <div class="metric-card">
            <div class="metric-header">
                <div class="metric-icon bg-blue-tint"><i class="fa-solid fa-box-open text-blue"></i></div>
                <span class="trend-indicator up"><i class="fa-solid fa-arrow-trend-up"></i> Live</span>
            </div>
            <div class="metric-body">
                <p class="metric-label">Total Orders</p>
                <h3 class="metric-value">@ViewBag.TotalOrders.ToString("N0")</h3>
            </div>
        </div>

        <div class="metric-card">
            <div class="metric-header">
                <div class="metric-icon bg-green-tint"><i class="fa-solid fa-warehouse text-green"></i></div>
                <span class="trend-indicator up"><i class="fa-solid fa-arrow-trend-up"></i> Live</span>
            </div>
            <div class="metric-body">
                <p class="metric-label">Warehouse Stock</p>
                <h3 class="metric-value">@ViewBag.TotalStock.ToString("N0")</h3>
            </div>
        </div>

        <div class="metric-card">
            <div class="metric-header">
                <div class="metric-icon bg-purple-tint"><i class="fa-solid fa-truck-fast text-purple"></i></div>
                <span class="trend-indicator up"><i class="fa-solid fa-arrow-trend-up"></i> Live</span>
            </div>
            <div class="metric-body">
                <p class="metric-label">Active Vehicles</p>
                <h3 class="metric-value">@ViewBag.ActiveVehicles</h3>
            </div>
        </div>

        <div class="metric-card">
            <div class="metric-header">
                <div class="metric-icon bg-orange-tint"><i class="fa-solid fa-dollar-sign text-orange"></i></div>
                <span class="trend-indicator up"><i class="fa-solid fa-arrow-trend-up"></i> Live</span>
            </div>
            <div class="metric-body">
                <p class="metric-label">Revenue (PKR)</p>
                <h3 class="metric-value">@ViewBag.TotalRevenue.ToString("N0")</h3>
            </div>
        </div>
    </div>

    <div class="charts-row">
        <div class="card chart-card-wrapper">
            <h3 class="card-title">Order Trends</h3>
            <div class="chart-mockup-container">
                <div class="chart-y-axis">
                    <span>800</span><span>600</span><span>400</span><span>200</span><span>0</span>
                </div>
                <div class="bar-chart-visual">
                    <div class="bar-group"><div class="bar bar-orange" style="height: 50%;"></div><span class="bar-label">Jan</span></div>
                    <div class="bar-group"><div class="bar bar-orange" style="height: 60%;"></div><span class="bar-label">Feb</span></div>
                    <div class="bar-group"><div class="bar bar-orange" style="height: 70%;"></div><span class="bar-label">Mar</span></div>
                    <div class="bar-group"><div class="bar bar-orange" style="height: 65%;"></div><span class="bar-label">Apr</span></div>
                    <div class="bar-group"><div class="bar bar-orange" style="height: 80%;"></div><span class="bar-label">May</span></div>
                    <div class="bar-group"><div class="bar bar-orange" style="height: 90%;"></div><span class="bar-label">Jun</span></div>
                </div>
            </div>
            <div class="chart-legend-bottom">
                <span class="legend-dot-item"><span class="dot-color bg-green"></span> Delivered</span>
                <span class="legend-dot-item"><span class="dot-color bg-orange"></span> Pending</span>
            </div>
        </div>

        <div class="card chart-card-wrapper">
            <h3 class="card-title">Revenue Trends (PKR)</h3>
            <div class="chart-mockup-container">
                <div class="chart-y-axis">
                    <span>320000</span><span>240000</span><span>160000</span><span>80000</span><span>0</span>
                </div>
                <div class="line-chart-visual">
                    <svg viewBox="0 0 500 150" class="svg-line-graph">
                        <path d="M 10,90 Q 100,60 190,75 T 370,30 T 490,20" fill="none" stroke="#3b82f6" stroke-width="3" />
                        <circle cx="10" cy="90" r="4" fill="#3b82f6" />
                        <circle cx="100" cy="68" r="4" fill="#3b82f6" />
                        <circle cx="190" cy="75" r="4" fill="#3b82f6" />
                        <circle cx="370" cy="30" r="4" fill="#3b82f6" />
                        <circle cx="490" cy="20" r="4" fill="#3b82f6" />
                    </svg>
                    <div class="line-labels-x">
                        <span>Jan</span><span>Feb</span><span>Mar</span><span>Apr</span><span>May</span><span>Jun</span>
                    </div>
                </div>
            </div>
            <div class="chart-legend-bottom">
                <span class="legend-dot-item"><span class="dot-color bg-blue"></span> Revenue</span>
            </div>
        </div>
    </div>

    <div class="dashboard-grid">
        <div class="card">
            <h3 class="card-title">Order Status Distribution</h3>
            <div class="chart-container">
                <div class="chart-label-left text-green">Delivered @ViewBag.DeliveredPct%</div>
                <div class="pie-chart"></div>
                <div class="chart-labels-right">
                    <span class="label-cancelled">Cancelled @ViewBag.CancelledPct%</span>
                    <span class="label-pending">Pending @ViewBag.PendingPct%</span>
                    <span class="label-transit">In Transit @ViewBag.InTransitPct%</span>
                </div>
            </div>
        </div>

        <div class="card">
            <h3 class="card-title">Recent Orders</h3>
            <div class="orders-list">
                @if (ViewBag.RecentOrders != null)
                {
                    @foreach (var order in ViewBag.RecentOrders)
                    {
                        <div class="order-item">
                            <div class="order-details">
                                <h4 class="order-id">ORD-@order.OrderID.ToString("D4")</h4>
                                <p class="customer-name">@order.CustomerName</p>
                                <span class="order-date">@order.OrderDate.ToString("yyyy-MM-dd")</span>
                            </div>
                            <div class="order-status-price">
                                @{
                                    // Assign appropriate badge color based on OrderStatus Enum
                                    string badgeClass = order.Status.ToString() == "Delivered" ? "badge-delivered" :
                                                        order.Status.ToString() == "Pending" ? "badge-pending" :
                                                        order.Status.ToString() == "Cancelled" ? "badge-danger" : "badge-transit";

                                    string statusText = order.Status.ToString().Replace("_", " ");
                                }
                                <span class="badge @badgeClass">@statusText</span>
                                <p class="order-price">PKR @order.TotalAmount.ToString("N0")</p>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p style="color: #94a3b8; font-size: 0.9rem; text-align:center; padding: 20px;">No recent orders found.</p>
                }
            </div>
        </div>

        <div class="card">
            <h3 class="card-title">Alerts & Notifications</h3>
            <div class="alerts-list">
                @if (ViewBag.Alerts != null && ViewBag.Alerts.Count > 0)
                {
                    @foreach (var alert in ViewBag.Alerts)
                    {
                        // The controller passes the alert text and the severity type separated by a pipe '|'
                        string[] alertParts = alert.Split('|');
                        string alertMessage = alertParts[0];
                        string alertType = alertParts.Length > 1 ? alertParts[1] : "warning";

                        <div class="alert-item">
                            @if (alertType == "warning")
                            {
                                <i class="fa-solid fa-triangle-exclamation alert-icon-warning"></i>
                            }
                            else
                            {
                                <i class="fa-solid fa-circle-xmark alert-icon-danger"></i>
                            }
                            <div class="alert-content">
                                <p class="alert-text">@alertMessage</p>
                                <span class="alert-time">Recent</span>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="alert-item">
                        <i class="fa-solid fa-circle-check alert-icon-success"></i>
                        <div class="alert-content">
                            <p class="alert-text">All systems operating normally. No alerts.</p>
                            <span class="alert-time">Just now</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>