@model Logitrack_ERP.Models.Product
@{
    ViewData["Title"] = "Add Product";
}

<div class="warehouse-management-wrapper" style="padding: 24px;">
    <div class="module-header" style="margin-bottom: 24px;">
        <h2 class="module-title" style="font-size: 1.5rem; font-weight: 700; color: #1e293b;">Register New Product</h2>
    </div>

    <div class="form-card-container" style="background: white; padding: 24px; border-radius: 8px; border: 1px solid #e2e8f0;">
        <form asp-action="Create" method="post" class="figma-styled-form">

            <div class="form-grid-3" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 20px;">
                <div class="input-group">
                    <label style="display: block; font-weight: 600; margin-bottom: 8px; color: #475569;">Product Name</label>
                    <input type="text" asp-for="ProductName" class="form-control" style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px;" placeholder="e.g. Solar Inverter" required />
                </div>
                <div class="input-group">
                    <label style="display: block; font-weight: 600; margin-bottom: 8px; color: #475569;">Price (PKR)</label>
                    <input type="number" step="0.01" asp-for="Price" class="form-control" style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px;" placeholder="e.g. 50000.00" required />
                </div>
                <div class="input-group">
                    <label style="display: block; font-weight: 600; margin-bottom: 8px; color: #475569;">Initial Stock Quantity</label>
                    <input type="number" asp-for="StockQuantity" class="form-control" style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px;" value="0" required />
                </div>
            </div>

            <div class="form-grid-3" style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; margin-bottom: 20px;">
                <div class="input-group">
                    <label style="display: block; font-weight: 600; margin-bottom: 8px; color: #475569;">Measurement Unit</label>
                    <select asp-for="Unit" class="form-control" style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px;" required>
                        <option value="Pieces">Pieces</option>
                        <option value="Boxes">Boxes</option>
                        <option value="Kilograms">Kilograms</option>
                        <option value="Liters">Liters</option>
                    </select>
                </div>
                <div class="input-group">
                    <label style="display: block; font-weight: 600; margin-bottom: 8px; color: #475569;">Status</label>
                    <select asp-for="Status" class="form-control" style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px;" required>
                        <option value="Available">Available</option>
                        <option value="Out of Stock">Out of Stock</option>
                        <option value="Discontinued">Discontinued</option>
                    </select>
                </div>
            </div>

            <div class="input-group" style="margin-bottom: 20px;">
                <label style="display: block; font-weight: 600; margin-bottom: 8px; color: #475569;">Description (Optional)</label>
                <textarea asp-for="Description" rows="3" class="form-control" style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px;" placeholder="Product details..."></textarea>
            </div>

            <div class="form-actions-row" style="display: flex; justify-content: flex-end; gap: 12px; border-top: 1px solid #e5e7eb; padding-top: 20px;">
                <a asp-action="Index" class="btn-secondary-cancel" style="padding: 10px 20px; background-color: #f3f4f6; color: #374151; text-decoration: none; border-radius: 6px; font-weight: 500;">Cancel</a>
                <button type="submit" class="btn-primary-submit" style="padding: 10px 20px; background-color: #2563eb; color: white; border: none; border-radius: 6px; font-weight: 500; cursor: pointer;">Save Product</button>
            </div>
        </form>
    </div>
</div>