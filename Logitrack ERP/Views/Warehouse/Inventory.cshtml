@model IEnumerable<Logitrack_ERP.Models.InventoryItem>

@{
    ViewData["Title"] = "Inventory Management";

    int totalProducts = Model != null ? Model.Count() : 0;
    // Assuming anything below 50 units triggers a "Low Stock" alert
    int lowStockAlerts = Model != null ? Model.Count(i => i.StockLevel < 50) : 0;
}

<div class="warehouse-management-wrapper" style="padding: 24px; background-color: #f8fafc; min-height: 100vh;">

    <div class="module-header" style="margin-bottom: 24px;">
        <h2 class="module-title" style="font-size: 1.5rem; font-weight: 700; color: #1e293b; margin-bottom: 4px;">Warehouse Management</h2>
        <p class="module-subtitle" style="color: #64748b; font-size: 0.95rem; margin: 0;">Track stock levels, product SKUs, and batch locations</p>
    </div>

    <div class="dashboard-cards" style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-bottom: 32px;">

        <div class="stat-card" style="background: white; padding: 20px; border-radius: 8px; border: 1px solid #e2e8f0;">
            <div style="background-color: #eff6ff; width: 40px; height: 40px; border-radius: 8px; display: flex; align-items: center; justify-content: center; margin-bottom: 12px;">
                <i class="fa-solid fa-layer-group" style="color: #3b82f6; font-size: 1.2rem;"></i>
            </div>
            <p style="color: #64748b; font-size: 0.85rem; font-weight: 600; margin-bottom: 4px;">Total Warehouses</p>
            <h3 style="color: #0f172a; font-size: 1.8rem; font-weight: 700; margin: 0;">3</h3>
        </div>

        <div class="stat-card" style="background: white; padding: 20px; border-radius: 8px; border: 1px solid #e2e8f0;">
            <div style="background-color: #ecfdf5; width: 40px; height: 40px; border-radius: 8px; display: flex; align-items: center; justify-content: center; margin-bottom: 12px;">
                <i class="fa-solid fa-boxes-stacked" style="color: #10b981; font-size: 1.2rem;"></i>
            </div>
            <p style="color: #64748b; font-size: 0.85rem; font-weight: 600; margin-bottom: 4px;">Total Products</p>
            <h3 style="color: #0f172a; font-size: 1.8rem; font-weight: 700; margin: 0;">@totalProducts</h3>
        </div>

        <div class="stat-card" style="background: white; padding: 20px; border-radius: 8px; border: 1px solid #e2e8f0;">
            <div style="background-color: #fff7ed; width: 40px; height: 40px; border-radius: 8px; display: flex; align-items: center; justify-content: center; margin-bottom: 12px;">
                <i class="fa-solid fa-triangle-exclamation" style="color: #ea580c; font-size: 1.2rem;"></i>
            </div>
            <p style="color: #64748b; font-size: 0.85rem; font-weight: 600; margin-bottom: 4px;">Low Stock Alerts</p>
            <h3 style="color: #ea580c; font-size: 1.8rem; font-weight: 700; margin: 0;">@lowStockAlerts</h3>
        </div>

        <div class="stat-card" style="background: white; padding: 20px; border-radius: 8px; border: 1px solid #e2e8f0;">
            <div style="background-color: #faf5ff; width: 40px; height: 40px; border-radius: 8px; display: flex; align-items: center; justify-content: center; margin-bottom: 12px;">
                <i class="fa-solid fa-chart-pie" style="color: #a855f7; font-size: 1.2rem;"></i>
            </div>
            <p style="color: #64748b; font-size: 0.85rem; font-weight: 600; margin-bottom: 4px;">Avg. Utilization</p>
            <h3 style="color: #0f172a; font-size: 1.8rem; font-weight: 700; margin: 0;">79%</h3>
        </div>

    </div>

    <div class="tabs-container" style="border-bottom: 2px solid #e2e8f0; margin-bottom: 20px; display: flex; gap: 24px;">
        <a asp-controller="Warehouse" asp-action="Index" style="text-decoration: none; color: #64748b; font-weight: 500; padding-bottom: 12px;">Warehouses</a>
        <a asp-controller="Warehouse" asp-action="Inventory" style="text-decoration: none; color: #2563eb; font-weight: 600; padding-bottom: 12px; border-bottom: 2px solid #2563eb; margin-bottom: -2px;">Inventory</a>
    </div>

    <div class="actions-bar" style="display: flex; justify-content: space-between; margin-bottom: 20px;">
        <div class="search-box" style="position: relative; width: 60%; max-width: 500px;">
            <i class="fa-solid fa-magnifying-glass" style="position: absolute; left: 16px; top: 12px; color: #94a3b8;"></i>
            <input type="text" placeholder="Search inventory by SKU or Name..." style="width: 100%; padding: 10px 10px 10px 42px; border: 1px solid #cbd5e1; border-radius: 6px; outline: none; font-size: 0.95rem;" />
        </div>

        <a asp-action="CreateInventory" style="background-color: #2563eb; color: white; padding: 10px 20px; border-radius: 6px; text-decoration: none; font-weight: 600; display: inline-flex; align-items: center; gap: 8px;">
            <i class="fa-solid fa-plus"></i> Add Stock Item
        </a>
    </div>

    <div class="table-container" style="background: white; border: 1px solid #e2e8f0; border-radius: 8px; overflow: hidden;">
        <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.9rem;">
            <thead style="background-color: #f8fafc; border-bottom: 1px solid #e2e8f0; color: #64748b; text-transform: uppercase; font-size: 0.75rem;">
                <tr>
                    <th style="padding: 16px;">SKU ID</th>
                    <th style="padding: 16px;">Product Name</th>
                    <th style="padding: 16px;">Category</th>
                    <th style="padding: 16px;">Batch No</th>
                    <th style="padding: 16px;">Stock Level</th>
                    <th style="padding: 16px;">Location Storage</th>
                    <th style="padding: 16px; text-align: right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr style="border-bottom: 1px solid #f1f5f9;">
                            <td style="padding: 16px; font-weight: 600; color: #475569;">@item.InventoryID</td>
                            <td style="padding: 16px; font-weight: 600; color: #0f172a;">@item.ProductName</td>
                            <td style="padding: 16px; color: #64748b;">@item.Category</td>
                            <td style="padding: 16px; color: #64748b;">@item.BatchNo</td>
                            <td style="padding: 16px;">
                                @if (item.StockLevel < 50)
                                {
                                    <span style="background: #fef3c7; color: #b45309; padding: 4px 8px; border-radius: 4px; font-size: 0.8rem; font-weight: 600;">@item.StockLevel Units (Low)</span>
                                }
                                else
                                {
                                    <span style="background: #d1fae5; color: #065f46; padding: 4px 8px; border-radius: 4px; font-size: 0.8rem; font-weight: 600;">@item.StockLevel Units</span>
                                }
                            </td>
                            <td style="padding: 16px; color: #64748b;">@item.LocationStorage</td>
                            <td style="padding: 16px; text-align: right;">
                                <a asp-action="EditInventory" asp-route-id="@item.InventoryID" style="color: #10b981; margin-right: 12px;"><i class="fa-regular fa-pen-to-square"></i></a>
                                <a asp-action="DeleteInventory" asp-route-id="@item.InventoryID" style="color: #ef4444;" onclick="return confirm('Delete this stock item?');"><i class="fa-regular fa-trash-can"></i></a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>