@model Logitrack_ERP.Models.InventoryItem
@{
    ViewData["Title"] = "Add Stock Item";
}

<div class="warehouse-management-wrapper" style="padding: 24px;">
    <div class="module-header" style="margin-bottom: 24px;">
        <h2 class="module-title" style="font-size: 1.5rem; font-weight: 700; color: #1e293b;">Register New Stock Item</h2>
    </div>

    <div class="form-card-container" style="background: white; padding: 24px; border-radius: 8px; border: 1px solid #e2e8f0;">
        <form asp-controller="Warehouse" asp-action="CreateInventory" method="post" class="figma-styled-form">
            <div class="form-section">

                <div class="form-grid-3" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 20px;">
                    <div class="input-group">
                        <label style="display: block; font-weight: 600; margin-bottom: 8px; color: #475569;">Select Warehouse</label>
                        <select asp-for="WarehouseID" class="form-control" asp-items="ViewBag.WarehouseList" style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px;" required>
                            <option value="">-- Please Select a Warehouse --</option>
                        </select>
                    </div>

                    <div class="input-group">
                        <label style="display: block; font-weight: 600; margin-bottom: 8px; color: #475569;">Select Product</label>
                        <select asp-for="ProductID" id="productDropdown" class="form-control" asp-items="ViewBag.ProductList" style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px;" onchange="document.getElementById('productNameField').value = this.options[this.selectedIndex].text;" required>
                            <option value="">-- Please Select a Product --</option>
                        </select>
                    </div>

                    <div class="input-group">
                        <label style="display: block; font-weight: 600; margin-bottom: 8px; color: #475569;">Product Name</label>
                        <input type="text" asp-for="ProductName" id="productNameField" class="form-control" style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px; background-color: #f1f5f9; color: #64748b;" readonly required />
                    </div>
                </div>

                <div class="form-grid-3" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 20px;">
                    <div class="input-group">
                        <label style="display: block; font-weight: 600; margin-bottom: 8px; color: #475569;">Category</label>
                        <select asp-for="Category" class="form-control" style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px;">
                            <option value="Electronics">Electronics</option>
                            <option value="Power Storage">Power Storage</option>
                            <option value="Raw Materials">Raw Materials</option>
                            <option value="Packaging">Packaging</option>
                        </select>
                    </div>

                    <div class="input-group">
                        <label style="display: block; font-weight: 600; margin-bottom: 8px; color: #475569;">Batch Number</label>
                        <input type="text" asp-for="BatchNo" class="form-control" style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px;" placeholder="e.g. BTCH-2026A" required />
                    </div>

                    <div class="input-group">
                        <label style="display: block; font-weight: 600; margin-bottom: 8px; color: #475569;">Current Stock Level</label>
                        <input type="number" asp-for="StockLevel" class="form-control" style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px;" placeholder="e.g. 140" required />
                    </div>
                </div>

                <div class="input-group" style="margin-bottom: 20px;">
                    <label style="display: block; font-weight: 600; margin-bottom: 8px; color: #475569;">Storage Location</label>
                    <input type="text" asp-for="LocationStorage" class="form-control" style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px;" placeholder="e.g. Lahore (Bay 4)" required />
                </div>
            </div>

            <div class="form-actions-row" style="display: flex; justify-content: flex-end; gap: 12px; border-top: 1px solid #e5e7eb; padding-top: 20px;">
                <a asp-controller="Warehouse" asp-action="Inventory" class="btn-secondary-cancel" style="padding: 10px 20px; background-color: #f3f4f6; color: #374151; text-decoration: none; border-radius: 6px; font-weight: 500;">Cancel</a>
                <button type="submit" class="btn-primary-submit" style="padding: 10px 20px; background-color: #2563eb; color: white; border: none; border-radius: 6px; font-weight: 500; cursor: pointer;">Save Stock Item</button>
            </div>
        </form>
    </div>
</div>