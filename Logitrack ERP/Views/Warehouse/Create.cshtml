@{
    ViewData["Title"] = "Add New Warehouse";
}

<div class="warehouse-management-wrapper">
    <div class="module-header">
        <h2 class="module-title">Add New Warehouse</h2>
        <p class="module-subtitle">Register a new storage location or distribution center</p>
    </div>

    <div class="form-card-container">
        <form class="figma-styled-form">
            <div class="form-section">
                <h3 class="section-subtitle"><i class="fa-solid fa-warehouse"></i> Warehouse Basic Info</h3>
                <div class="form-grid-3">
                    <div class="input-group">
                        <label class="form-label">Warehouse Name</label>
                        <input type="text" class="form-control-input" placeholder="e.g. Faisalabad Logistics Hub" required />
                    </div>
                    <div class="input-group">
                        <label class="form-label">Total Capacity (sq ft)</label>
                        <input type="number" class="form-control-input" placeholder="e.g. 40000" required />
                    </div>
                    <div class="input-group">
                        <label class="form-label">Current Stock Occupied (sq ft)</label>
                        <input type="number" class="form-control-input" placeholder="e.g. 10000" />
                    </div>
                </div>
            </div>

            <div class="form-section">
                <h3 class="section-subtitle"><i class="fa-solid fa-map-pin"></i> Location Details</h3>
                <div class="input-group full-width-input">
                    <label class="form-label">Warehouse Address</label>
                    <textarea class="form-control-textarea" rows="3" placeholder="Enter complete physical address..."></textarea>
                </div>
            </div>

            <div class="form-actions-row">
                <a asp-controller="Warehouse" asp-action="Index" class="btn-secondary-cancel">Cancel</a>
                <button type="submit" class="btn-primary-submit"><i class="fa-solid fa-check"></i> Save Warehouse</button>
            </div>
        </form>
    </div>
</div>