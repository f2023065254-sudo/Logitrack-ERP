@{
    ViewData["Title"] = "Edit Inventory Item";
}

<div class="orders-management-wrapper">
    <div class="module-header">
        <h2 class="module-title">Edit Stock Item: SKU-4412</h2>
        <p class="module-subtitle">Update stock levels, batch details, or relocate item storage</p>
    </div>

    <div class="form-card-container">
        <form class="figma-styled-form">
            <div class="form-section">
                <h3 class="section-subtitle"><i class="fa-solid fa-box"></i> Product & Category</h3>
                <div class="form-grid-3">
                    <div class="input-group">
                        <label class="form-label">Product Name</label>
                        <input type="text" class="form-control-input" value="Lithium Battery Packs Pack 100AH" required />
                    </div>
                    <div class="input-group">
                        <label class="form-label">Category</label>
                        <select class="form-control-select" required>
                            <option value="Electronics">Electronics</option>
                            <option value="Power Storage" selected>Power Storage</option>
                        </select>
                    </div>
                    <div class="input-group">
                        <label class="form-label">Batch Number</label>
                        <input type="text" class="form-control-input" value="BTCH-2026C" />
                    </div>
                </div>
            </div>

            <div class="form-section">
                <h3 class="section-subtitle"><i class="fa-solid fa-cubes"></i> Stock & Location Assignment</h3>
                <div class="form-grid-3">
                    <div class="input-group">
                        <label class="form-label">Stock Level (Units)</label>
                        <input type="number" class="form-control-input" value="12" required />
                    </div>
                    <div class="input-group">
                        <label class="form-label">Warehouse Location</label>
                        <select class="form-control-select" required>
                            <option value="Lahore (Bay 4)">Lahore (Bay 4)</option>
                            <option value="Karachi (Zone B)" selected>Karachi (Zone B)</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="form-actions-row">
                <a asp-controller="Warehouse" asp-action="Inventory" class="btn-secondary-cancel">Cancel Changes</a>
                <button type="submit" class="btn-primary-submit"><i class="fa-solid fa-arrows-rotate"></i> Update Item</button>
            </div>
        </form>
    </div>
</div>