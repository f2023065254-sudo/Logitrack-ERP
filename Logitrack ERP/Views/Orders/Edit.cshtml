@{
    ViewData["Title"] = "Modify Order";
}

<div class="orders-management-wrapper">
    <div class="module-header">
        <h2 class="module-title">Edit Order: ORD-1234</h2>
        <p class="module-subtitle">Update parameters or delivery routing status for this order</p>
    </div>

    <div class="form-card-container">
        <form class="figma-styled-form">

            <div class="form-section">
                <h3 class="section-subtitle"><i class="fa-solid fa-user-tag"></i> Customer Information</h3>
                <div class="form-grid-3">
                    <div class="input-group">
                        <label class="form-label">Customer Name</label>
                        <input type="text" class="form-control-input" value="Ahmed Khan" required />
                    </div>
                    <div class="input-group">
                        <label class="form-label">Customer ID</label>
                        <input type="text" class="form-control-input" value="CUST-001" readonly style="background-color: #f1f5f9; cursor: not-allowed;" />
                    </div>
                    <div class="input-group">
                        <label class="form-label">Contact Number</label>
                        <input type="tel" class="form-control-input" value="0321-7654321" />
                    </div>
                </div>
            </div>

            <div class="form-section">
                <h3 class="section-subtitle"><i class="fa-solid fa-box-open"></i> Order Specification</h3>
                <div class="form-grid-3">
                    <div class="input-group">
                        <label class="form-label">Total Amount (PKR)</label>
                        <input type="text" class="form-control-input" value="12,500" required />
                    </div>
                    <div class="input-group">
                        <label class="form-label">Order Status</label>
                        <select class="form-control-select">
                            <option value="Delivered" selected>Delivered</option>
                            <option value="In Transit">In Transit</option>
                            <option value="Pending">Pending</option>
                        </select>
                    </div>
                    <div class="input-group">
                        <label class="form-label">Order Date</label>
                        <input type="date" class="form-control-input" value="2026-05-18" />
                    </div>
                </div>
            </div>

            <div class="form-section">
                <h3 class="section-subtitle"><i class="fa-solid fa-map-location-dot"></i> Destination Logistics</h3>
                <div class="input-group full-width-input">
                    <label class="form-label">Delivery Address</label>
                    <textarea class="form-control-textarea" rows="3">123 Main St, Lahore</textarea>
                </div>
            </div>

            <div class="form-actions-row">
                <a asp-controller="Orders" asp-action="Index" class="btn-secondary-cancel">Cancel Changes</a>
                <button type="submit" class="btn-primary-submit"><i class="fa-solid fa-arrows-rotate"></i> Update Order</button>
            </div>

        </form>
    </div>
</div>