@model Logitrack_ERP.Models.Order
@{
    ViewData["Title"] = "Create New Order";
}

<div class="orders-management-wrapper">
    <div class="module-header">
        <h2 class="module-title">Create New Order</h2>
        <p class="module-subtitle">Enter details to register a new customer order</p>
    </div>

    <div class="form-card-container">
        <form asp-controller="Orders" asp-action="Create" method="post" class="figma-styled-form">

            <div class="form-section">
                <h3 class="section-subtitle">Customer Information</h3>
                <div class="form-grid-3">
                    <div class="input-group">
                        <label class="form-label">Customer Name</label>
                        <input asp-for="CustomerName" class="form-control-input" placeholder="e.g. Ahmed Khan" />
                    </div>
                    <div class="input-group">
                        <label class="form-label">Customer ID</label>
                        <input asp-for="CustomerID" class="form-control-input" placeholder="e.g. 5" />
                    </div>
                    <div class="input-group">
                        <label class="form-label">Contact Number</label>
                        <input asp-for="ContactNo" class="form-control-input" placeholder="e.g. 0300-1234567" />
                    </div>
                </div>
            </div>

            <div class="form-section">
                <h3 class="section-subtitle">Order Specification</h3>
                <div class="form-grid-3">
                    
                    <div class="input-group">
                        <label class="form-label">Total Amount (PKR)</label>
                        <input asp-for="TotalAmount" class="form-control-input" placeholder="e.g. 15000" />
                    </div>
                    <div class="input-group">
                        <label class="form-label">Order Status</label>
                        <select asp-for="Status" class="form-control-select">
                            <option value="Pending">Pending</option>
                            <option value="In_Transit">In_Transit</option>
                            <option value="Delivered">Delivered</option>
                        </select>
                    </div>
                    <div class="input-group">
                        <label class="form-label">Order Date</label>
                        <input asp-for="OrderDate" type="date" class="form-control-input" />
                    </div>
                </div>
            </div>

            <div class="form-section">
                <h3 class="section-subtitle">Destination Logistics</h3>
                <div class="input-group full-width-input">
                    <label class="form-label">Delivery Address</label>
                    <textarea asp-for="DeliveryAddress" class="form-control-textarea" rows="3" placeholder="Enter complete address..."></textarea>
                </div>
            </div>

            <div class="form-actions-row">
                <a asp-controller="Orders" asp-action="Index" class="btn-secondary-cancel">Cancel</a>
                <button type="submit" class="btn-primary-submit">Save Order</button>
            </div>

        </form>
    </div>
</div>