@model Logitrack_ERP.Models.Order
@{
    ViewData["Title"] = "Create New Order";
}

<div class="orders-management-wrapper" style="padding: 24px;">
    <div class="module-header" style="margin-bottom: 24px;">
        <h2 class="module-title" style="font-size: 1.5rem; font-weight: 700; color: #1e293b;">Create New Order</h2>
    </div>

    <div class="form-card-container" style="background: white; padding: 24px; border-radius: 8px; border: 1px solid #e2e8f0;">
        <form asp-controller="Orders" asp-action="Create" method="post">
            <div class="form-grid-3" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 20px;">
                <div class="input-group">
                    <label style="display: block; font-weight: 600; margin-bottom: 8px; color: #475569;">Customer Name</label>
                    <input asp-for="CustomerName" class="form-control" style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px;" required />
                </div>
                <div class="input-group">
                    <label style="display: block; font-weight: 600; margin-bottom: 8px; color: #475569;">Customer ID</label>
                    <input asp-for="CustomerID" class="form-control" style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px;" required />
                </div>
                <div class="input-group">
                    <label style="display: block; font-weight: 600; margin-bottom: 8px; color: #475569;">Contact Number</label>
                    <input asp-for="ContactNo" class="form-control" style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px;" required />
                </div>
                <div class="input-group">
                    <label style="display: block; font-weight: 600; margin-bottom: 8px; color: #475569;">Total Amount (PKR)</label>
                    <input asp-for="TotalAmount" type="number" step="0.01" class="form-control" style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px;" required />
                </div>
                <div class="input-group">
                    <label style="display: block; font-weight: 600; margin-bottom: 8px; color: #475569;">Order Status</label>
                    <select asp-for="Status" class="form-control" style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px;">
                        <option value="Pending">Pending</option>
                        <option value="In_Transit">In Transit</option>
                        <option value="Delivered">Delivered</option>
                    </select>
                </div>
                <div class="input-group">
                    <label style="display: block; font-weight: 600; margin-bottom: 8px; color: #475569;">Order Date</label>
                    <input asp-for="OrderDate" type="date" class="form-control" style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px;" required />
                </div>
            </div>

            <div class="input-group" style="margin-bottom: 20px;">
                <label style="display: block; font-weight: 600; margin-bottom: 8px; color: #475569;">Delivery Address</label>
                <textarea asp-for="DeliveryAddress" rows="3" class="form-control" style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 6px;" required></textarea>
            </div>

            <div class="form-actions-row" style="display: flex; justify-content: flex-end; gap: 12px; border-top: 1px solid #e5e7eb; padding-top: 20px;">
                <a asp-controller="Orders" asp-action="Index" class="btn-secondary-cancel" style="padding: 10px 20px; background-color: #f3f4f6; color: #374151; text-decoration: none; border-radius: 6px; font-weight: 500;">Cancel</a>
                <button type="submit" class="btn-primary-submit" style="padding: 10px 20px; background-color: #2563eb; color: white; border: none; border-radius: 6px; font-weight: 500; cursor: pointer;">Save Order</button>
            </div>
        </form>
    </div>
</div>