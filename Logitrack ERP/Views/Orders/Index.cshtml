@model IEnumerable<Logitrack_ERP.Models.Order>
@{
    ViewData["Title"] = "Order Management";
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger" style="margin: 20px 24px 0 24px; padding: 15px; background-color: #f8d7da; color: #842029; border: 1px solid #f5c2c7; border-radius: 6px;">
        @TempData["ErrorMessage"]
    </div>
}

<div class="orders-management-wrapper" style="padding: 24px; background-color: #f8fafc; min-height: 100vh;">
    <div class="module-header" style="margin-bottom: 24px;">
        <h2 class="module-title" style="font-size: 1.5rem; font-weight: 700; color: #1e293b;">Order Management</h2>
        <p class="module-subtitle" style="color: #64748b; font-size: 0.95rem;">Manage customer orders from placement to delivery</p>
    </div>

    <div class="controls-bar" style="display: flex; justify-content: space-between; margin-bottom: 20px;">
        <div class="search-box-wrapper" style="position: relative; width: 60%; max-width: 500px;">
            <i class="fa-solid fa-magnifying-glass" style="position: absolute; left: 16px; top: 12px; color: #94a3b8;"></i>
            <input type="text" placeholder="Search orders by ID or customer..." style="width: 100%; padding: 10px 10px 10px 42px; border: 1px solid #cbd5e1; border-radius: 6px; outline: none;" />
        </div>

        <div class="action-buttons-group">
            <a asp-controller="Orders" asp-action="Create" style="background-color: #2563eb; color: white; padding: 10px 20px; border-radius: 6px; text-decoration: none; font-weight: 600; display: inline-flex; align-items: center; gap: 8px;">
                <i class="fa-solid fa-plus"></i> Create Order
            </a>
        </div>
    </div>

    <div class="orders-table-card" style="background: white; border: 1px solid #e2e8f0; border-radius: 8px; overflow: hidden;">
        <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.9rem;">
            <thead style="background-color: #f8fafc; border-bottom: 1px solid #e2e8f0; color: #64748b; text-transform: uppercase; font-size: 0.75rem;">
                <tr>
                    <th style="padding: 16px;">ORDER ID</th>
                    <th style="padding: 16px;">CUSTOMER</th>
                    <th style="padding: 16px;">ORDER DATE</th>
                    <th style="padding: 16px;">STATUS</th>
                    <th style="padding: 16px;">TOTAL AMOUNT</th>
                    <th style="padding: 16px;">DELIVERY ADDRESS</th>
                    <th style="padding: 16px; text-align: right;">ACTIONS</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr style="border-bottom: 1px solid #f1f5f9;">
                            <td style="padding: 16px; font-weight: 600; color: #475569;">ORD-@item.OrderID.ToString("D4")</td>
                            <td style="padding: 16px;">
                                <div style="font-weight: 600; color: #0f172a;">@item.CustomerName</div>
                                <div style="color: #64748b; font-size: 0.8rem;">CUST-@item.CustomerID.ToString("D3")</div>
                            </td>
                            <td style="padding: 16px; color: #64748b;">@item.OrderDate.ToString("yyyy-MM-dd")</td>

                            <td style="padding: 16px;">
                                @if (item.Status == Logitrack_ERP.Models.OrderStatus.Delivered)
                                {
                                    <span style="background: #d1fae5; color: #065f46; padding: 4px 8px; border-radius: 12px; font-size: 0.8rem; font-weight: 600;">Delivered</span>
                                }
                                else if (item.Status == Logitrack_ERP.Models.OrderStatus.In_Transit)
                                {
                                    <span style="background: #dbeafe; color: #1e40af; padding: 4px 8px; border-radius: 12px; font-size: 0.8rem; font-weight: 600;">In Transit</span>
                                }
                                else
                                {
                                    <span style="background: #fef3c7; color: #b45309; padding: 4px 8px; border-radius: 12px; font-size: 0.8rem; font-weight: 600;">@item.Status.ToString()</span>
                                }
                            </td>

                            <td style="padding: 16px; font-weight: 600; color: #0f172a;">PKR @item.TotalAmount.ToString("N0")</td>
                            <td style="padding: 16px; color: #64748b;">@item.DeliveryAddress</td>
                            <td style="padding: 16px; text-align: right;">
                                <a asp-controller="Orders" asp-action="Edit" asp-route-id="@item.OrderID" style="color: #10b981; margin-right: 12px;"><i class="fa-regular fa-pen-to-square"></i></a>
                                <a asp-controller="Orders" asp-action="Delete" asp-route-id="@item.OrderID" style="color: #ef4444;" onclick="return confirm('Delete this order?');"><i class="fa-regular fa-trash-can"></i></a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" style="text-align: center; padding: 40px; color: #94a3b8;">No orders found in the database.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>